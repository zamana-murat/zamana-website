---
import '../styles/wiki.css';
import Layout from './Layout.astro';
import WikiSidebar from '../components/WikiSidebar.astro';
import WikiTabs from '../components/WikiTabs.astro';
import WikiBreadcrumb from '../components/WikiBreadcrumb.astro';
import WikiPrevNext from '../components/WikiPrevNext.astro';
import RetainerCTA from '../components/RetainerCTA.astro';
import type { RetainerVariant } from '../data/retainer-variants';
import WikiTOC from '../components/WikiTOC.astro';
import { findNav } from '../data/wiki-nav';
import type { MarkdownHeading } from 'astro';
import { composeTitle, ORG_REF, WIKI_SECTION_LABELS } from '../data/seo';

interface Props {
  slug: string;
  title: string;
  seoTitle?: string;
  description?: string;
  tags?: string[];
  headings?: MarkdownHeading[];
  publishDate?: string;
  modifiedDate?: string;
}

const {
  slug,
  title,
  seoTitle,
  description,
  headings = [],
  publishDate,
  modifiedDate,
} = Astro.props;

const { section, prev, next } = findNav(slug);

// Contextual program CTA, picked from the page path (no frontmatter needed).
const KURUMSAL_TEMELLER = new Set([
  'planlar', 'kullanim-limitleri', 'takim-ve-admin', 'fatura-ve-kdv',
  'pilot-ve-yayginlastirma', 'sirket-ici-politika',
]);
const DEPARTMAN_VARIANTS: Record<string, RetainerVariant> = {
  'hukuk': 'hukuk',
  'ihracat': 'ihracat',
  'kamu': 'kamu',
  'egitim-akademi': 'akademi',
  'insan-kaynaklari': 'sampiyon',
  'liderlik': 'yonetici',
  'kobi': 'bireysel',
};
function ctaVariantFor(s: string): RetainerVariant {
  const [group, page] = s.split('/');
  if (group === 'temeller' && page && KURUMSAL_TEMELLER.has(page)) return 'kurumsal';
  if (group === 'departmanlar' && page) return DEPARTMAN_VARIANTS[page] ?? 'kurumsal';
  if (group === 'gorevler' && page) return 'bireysel';
  return 'default';
}
const ctaVariant = ctaVariantFor(slug);

// Format ISO date (2026-05-06) → Turkish display ("6 Mayıs 2026")
const trMonths = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran',
  'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
let lastUpdatedDisplay: string | null = null;
if (modifiedDate && /^\d{4}-\d{2}-\d{2}$/.test(modifiedDate)) {
  const [y, m, d] = modifiedDate.split('-').map(Number);
  lastUpdatedDisplay = `${d} ${trMonths[m - 1]} ${y}`;
}

// Build canonical OG image slug. We'll generate one OG per wiki page:
// `wiki-<slug-with-dashes>.png`. Slug `temeller/claude-nedir` → `wiki-temeller-claude-nedir`.
const safeSlug = slug ? `wiki-${slug.replace(/\//g, '-')}` : 'wiki-index';
const ogImage = `/og/${safeSlug}.png`;

const siteUrl = 'https://zamana.com.tr';
const pageUrl = `${siteUrl}/wiki/${slug ? slug + '/' : ''}`;

// Schema.org Article + BreadcrumbList for the wiki page
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description || title,
  image: `${siteUrl}${ogImage}`,
  datePublished: (publishDate || modifiedDate) ? `${publishDate || modifiedDate}T00:00:00+03:00` : undefined,
  dateModified: modifiedDate ? `${modifiedDate}T00:00:00+03:00` : undefined,
  author: {
    '@type': 'Person',
    name: 'Murat Özsaygılı',
    url: `${siteUrl}/hakkinda/`,
  },
  publisher: ORG_REF,
  mainEntityOfPage: pageUrl,
  inLanguage: 'tr-TR',
};

// Wiki-specific BreadcrumbList (overrides Layout's auto-generated one with proper labels)
const breadcrumbItems = [
  { name: 'Anasayfa', url: `${siteUrl}/` },
  { name: 'Wiki', url: `${siteUrl}/wiki/` },
];
const fallbackSection = !section && slug.includes('/') ? slug.split('/')[0] : '';
if (section && slug && slug !== section.landingSlug) {
  breadcrumbItems.push({ name: section.label, url: `${siteUrl}/wiki/${section.landingSlug}/` });
} else if (fallbackSection && WIKI_SECTION_LABELS[fallbackSection]) {
  breadcrumbItems.push({ name: WIKI_SECTION_LABELS[fallbackSection], url: `${siteUrl}/wiki/${fallbackSection}/` });
}
if (slug) {
  breadcrumbItems.push({ name: title, url: pageUrl });
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};
---

<Layout
  title={composeTitle(title, ' | Zamana', seoTitle)}
  description={description || title}
  ogImage={ogImage}
  ogType="article"
  publishDate={publishDate || modifiedDate}
  modifiedDate={modifiedDate}
  skipAutoBreadcrumb={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <WikiTabs activeSlug={slug} />

  <div class={`wiki-shell ${section ? '' : 'wiki-shell--no-sidebar'}`}>
    <WikiSidebar activeSlug={slug} />

    <article class="wiki-article">
      {slug && <WikiBreadcrumb slug={slug} title={title} />}
      <header class="wiki-article__header">
        <h1>{title}</h1>
        <p class="wiki-byline">
          <span>Yazan: <a href="/hakkinda/" rel="author">Murat Özsaygılı</a></span>
          {lastUpdatedDisplay && (
            <span>Son güncelleme: <time datetime={modifiedDate}>{lastUpdatedDisplay}</time></span>
          )}
        </p>
      </header>

      <WikiTOC headings={headings} />

      <div class="wiki-prose" data-pagefind-body>
        <slot />
      </div>

      <RetainerCTA variant={ctaVariant} />

      <WikiPrevNext prev={prev} next={next} />
    </article>
  </div>
</Layout>

<style>
  /* Wiki uses a wider max-width than the marketing site (1440px vs 1200px),
     matching the old MkDocs Material layout proportions. The shared token
     --wiki-max-w lives in src/styles/wiki.css and is also consumed by
     WikiTabs so the inner bar lines up. */
  .wiki-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 2.5rem;
    max-width: var(--wiki-max-w);
    margin: 0 auto;
    padding: 2rem var(--s-4) 4rem;
  }
  .wiki-shell--no-sidebar {
    grid-template-columns: minmax(0, 1fr);
    max-width: 880px;
  }
  .wiki-article { min-width: 0; }
  .wiki-article__header { margin-bottom: 1.5rem; }
  .wiki-article__header h1 {
    color: var(--c-navy);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }
  .wiki-article__lead {
    color: var(--c-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }
  .wiki-byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin: 0.25rem 0 0;
    color: var(--c-text-muted);
    font-size: 0.875rem;
  }
  .wiki-byline span + span::before {
    content: '\00B7';
    margin-right: 0.6rem;
    color: var(--c-gold-dark);
    font-weight: 700;
  }
  .wiki-byline a {
    color: var(--c-navy);
    font-weight: 600;
    text-decoration: none;
  }
  .wiki-byline a:hover {
    color: var(--c-gold-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 960px) {
    .wiki-shell {
      grid-template-columns: 1fr;
      padding: 1rem var(--s-3) 3rem;
    }
  }
</style>
