---
import Layout from './Layout.astro';
import RetainerCTA from '../components/RetainerCTA.astro';
import '../styles/wiki.css';
import { composeTitle } from '../data/seo';
import type { CollectionEntry } from 'astro:content';

// Hero animations: src/components/claude-anim/<name>.astro, selected by frontmatter heroAnimation.
const anims = import.meta.glob('../components/claude-anim/*.astro', { eager: true }) as Record<string, { default: any }>;

interface Props {
  data: CollectionEntry<'claude'>['data'];
  /** '' for the /claude/ hub, otherwise the content slug. */
  slug: string;
}

const { data, slug } = Astro.props;
const {
  title, seoTitle, description, eyebrow, lead, heroImage, heroVideo, heroAnimation, heroAlt,
  availability, sourceUrl, sourceTitle, related, lastUpdated,
} = data;

const SITE = 'https://zamana.com.tr';
const isHub = slug === '';
const pagePath = isHub ? '/claude/' : `/claude/${slug}/`;
const pageUrl = new URL(pagePath, SITE).toString();
const ogImage = heroImage || '/og/default.png';
const HeroAnim = heroAnimation ? anims[`../components/claude-anim/${heroAnimation}.astro`]?.default : undefined;
if (heroAnimation && !HeroAnim) throw new Error(`Unknown heroAnimation "${heroAnimation}" (no src/components/claude-anim/${heroAnimation}.astro)`);

const crumbs = [
  { name: 'Anasayfa', href: '/' },
  { name: 'Claude', href: '/claude/' },
  ...(isHub ? [] : [{ name: title, href: pagePath }]),
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  headline: title,
  description,
  url: pageUrl,
  inLanguage: 'tr-TR',
  dateModified: `${lastUpdated}T00:00:00+03:00`,
  primaryImageOfPage: { '@type': 'ImageObject', url: new URL(ogImage, SITE).toString() },
  isPartOf: { '@type': 'WebSite', name: 'Zamana', url: SITE },
  publisher: { '@type': 'Organization', name: 'Zamana', url: SITE },
  isBasedOn: { '@type': 'CreativeWork', url: sourceUrl, name: sourceTitle, publisher: { '@type': 'Organization', name: 'Anthropic' } },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, SITE).toString(),
  })),
};
---

<Layout
  title={composeTitle(title, ' | Zamana', seoTitle)}
  description={description}
  ogImage={ogImage}
  modifiedDate={lastUpdated}
  skipAutoBreadcrumb
>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="cl">
    <header class="cl-hero">
      <div class="container">
        <nav class="cl-crumbs" aria-label="Sayfa yolu">
          <ol>
            {crumbs.map((c, i) => (
              i === crumbs.length - 1
                ? <li aria-current="page">{c.name}</li>
                : <li><a href={c.href}>{c.name}</a></li>
            ))}
          </ol>
        </nav>

        <div class={`cl-hero__grid${HeroAnim || heroVideo || heroImage ? '' : ' cl-hero__grid--solo'}`}>
          <div class="cl-hero__text">
            <span class="eyebrow">{eyebrow}</span>
            <h1>{title}</h1>
            <p class="lead">{lead}</p>
            <div class="cl-avail" role="note">
              <span class="cl-avail__label">Hangi planda</span>
              <span class="cl-avail__value">{availability}</span>
            </div>
          </div>

          {HeroAnim ? (
            <figure class="cl-hero__media">
              <HeroAnim />
            </figure>
          ) : (heroVideo || heroImage) && (
            <figure class="cl-hero__media">
              {heroVideo ? (
                <video
                  src={heroVideo}
                  poster={heroImage}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={heroAlt || title}
                ></video>
              ) : (
                <img src={heroImage} alt={heroAlt || ''} width="1600" height="900" decoding="async" fetchpriority="high" />
              )}
            </figure>
          )}
        </div>
      </div>
    </header>

    <div class="container-narrow cl-body">
      <div class="wiki-prose">
        <slot />
      </div>
    </div>

    <slot name="after-body" />

    <div class="container-narrow cl-tail">
      {related && related.length > 0 && (
        <section class="cl-related" aria-labelledby="cl-related-h">
          <h2 id="cl-related-h">İlgili sayfalar</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={r.href} class="cl-related__card">
                  <span>{r.label}</span>
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <aside class="cl-source" aria-label="Kaynak ve not">
        <span class="cl-source__label">Kaynak ve not</span>
        <p>
          Bu sayfa, Zamana tarafından hazırlanmış Türkçe bir tanıtımdır. Claude, ürün adları ve görseller Anthropic'e aittir.
          Resmi sayfa: <a href={sourceUrl} target="_blank" rel="noopener">{sourceTitle}</a>.
        </p>
      </aside>

      <RetainerCTA intro="Claude'u tanıdınız; ekibinizin onu her gün verimli kullanması ise eğitim ister." />
    </div>
  </article>
</Layout>

<style>
  .cl-hero {
    padding: var(--s-5) 0 var(--s-6);
    background: var(--c-bg-subtle);
    border-bottom: 1px solid var(--c-border);
  }
  .cl-crumbs ol {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }
  .cl-crumbs li + li::before {
    content: '\203A';
    margin-right: 0.35rem;
    color: var(--c-gold-text);
  }
  .cl-crumbs a { color: var(--c-text-muted); text-decoration: none; }
  .cl-crumbs a:hover { color: var(--c-navy); text-decoration: underline; }
  .cl-crumbs [aria-current='page'] { color: var(--c-navy); font-weight: 600; }

  .cl-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-6);
    align-items: center;
  }
  .cl-hero__grid--solo { grid-template-columns: minmax(0, 1fr); max-width: 820px; }
  .cl-hero__text h1 { margin: 0 0 var(--s-3); line-height: 1.15; }
  .cl-hero__text .lead { margin-bottom: var(--s-4); }
  .cl-avail {
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 1rem;
    background: var(--c-white);
    border: 1px solid var(--c-border-gold);
    border-left: 3px solid var(--c-gold);
    border-radius: var(--r-card);
    max-width: 60ch;
  }
  .cl-avail__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-gold-text);
  }
  .cl-avail__value { font-size: 0.95rem; font-weight: 600; color: var(--c-navy); }
  .cl-hero__media {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background: var(--c-cream);
    box-shadow: var(--sh-mid);
  }
  .cl-hero__media img,
  .cl-hero__media video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .cl-hero__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  }

  .cl-body { padding-top: var(--s-6); }
  .cl-body :global(video),
  .cl-body :global(img) { max-width: 100%; height: auto; border-radius: var(--r-card); }

  .cl-tail { padding-bottom: var(--s-7); }
  .cl-related { margin-top: var(--s-6); }
  .cl-related h2 { font-size: 1.25rem; margin: 0 0 var(--s-3); }
  .cl-related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-2);
  }
  .cl-related__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    height: 100%;
    padding: 0.8rem 1rem;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-card);
    color: var(--c-navy);
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
    transition: border-color var(--t-fast), color var(--t-fast), box-shadow var(--t-fast);
  }
  .cl-related__card svg { flex-shrink: 0; color: var(--c-text-muted); }
  .cl-related__card:hover { border-color: var(--c-gold); color: var(--c-gold-text); box-shadow: var(--sh-soft); }
  .cl-related__card:hover svg { color: var(--c-gold-text); }
  .cl-related__card:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; }

  .cl-source {
    margin: var(--s-6) 0 var(--s-5);
    padding: var(--s-4);
    border: 1px solid var(--c-border-gold);
    border-left: 4px solid var(--c-gold);
    border-radius: var(--r-card);
    background: var(--c-bg-subtle);
  }
  .cl-source__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold-text);
    margin-bottom: var(--s-1);
  }
  .cl-source p { margin: 0; font-size: 0.93rem; color: var(--c-text-muted); }
  .cl-source a { font-weight: 700; color: var(--c-navy); overflow-wrap: anywhere; }
</style>
