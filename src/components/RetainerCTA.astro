---
/**
 * Program CTA box shown at the end of wiki pages and /claude/, /kurumsal/ pages.
 * `variant` picks a contextual program (WikiLayout selects it from the page path).
 * Prices follow the Locked list in the root CLAUDE.md ("Fiyatlar"); keep them in sync
 * with the program pages under src/pages/programlar/.
 */
import type { RetainerVariant } from '../data/retainer-variants';

interface Props {
  intro?: string;
  variant?: RetainerVariant;
}
const {
  intro = "Bu wiki'yi okudunuz, ama tek başına okumak yetmez.",
  variant = 'default',
} = Astro.props;

interface VariantCopy {
  heading: string;
  /** HTML, authored here only (no user input). */
  body: string;
  primary: { label: string; href: string };
}

const VAT = 'Fiyatlara KDV dahil değildir.';

const VARIANTS: Record<RetainerVariant, VariantCopy> = {
  default: {
    heading: "Claude'u şirketinize entegre edelim.",
    body: `Zamana, <a href="/yapay-zeka-egitimi/">kurumsal yapay zeka eğitimi</a> için üç program sunuyor:
      <strong>Yönetici AI Hazırlık</strong> (3 saat, 15.000 TL),
      <strong>Bireysel Program</strong> (3 hafta birebir, 40.000 TL) veya
      <strong>Kurumsal Retainer</strong> (6 çalışan, aylık 100.000 TL, minimum 3 ay). ${VAT}`,
    primary: { label: 'Programları İncele', href: '/programlar/' },
  },
  kurumsal: {
    heading: "Claude'u şirketinize entegre edelim.",
    body: `Zamana'nın <a href="/programlar/kurumsal/">kurumsal yapay zeka eğitimi programı</a> 6 çalışanla başlar:
      departman bazlı müfredat, şirket içi Claude şampiyonları, telefon desteği ve KVKK rehberliği.
      <strong>Aylık 100.000 TL</strong>, minimum 3 ay, ödeme aylık. ${VAT}`,
    primary: { label: 'Kurumsal Programı İncele', href: '/programlar/kurumsal/' },
  },
  bireysel: {
    heading: "Claude'u kendi işinizle öğrenin.",
    body: `<a href="/programlar/bireysel/">Bireysel Program</a>: 3 hafta boyunca birebir, kendi dosyalarınız ve
      görevleriniz üzerinden Claude eğitimi, ardından 3 ay telefon desteği.
      <strong>40.000 TL</strong>, tek seferlik ödeme. ${VAT}`,
    primary: { label: 'Bireysel Programı İncele', href: '/programlar/bireysel/' },
  },
  hukuk: {
    heading: "Claude'u büronuzun işine uyarlayalım.",
    body: `<a href="/programlar/hukuk-burolari/">Hukuk Büroları programı</a>: 3 hafta, sözleşme inceleme,
      dilekçe taslağı, atıf doğrulama ve müvekkil sırrı üzerine, 3 ay destekle.
      Tek avukat <strong>45.000 TL</strong>, her ek kişi 20.000 TL (2-4 kişi). ${VAT}`,
    primary: { label: 'Programı İncele', href: '/programlar/hukuk-burolari/' },
  },
  ihracat: {
    heading: "Claude'u ihracat ekibinize uyarlayalım.",
    body: `<a href="/programlar/ihracatcilar/">İhracatçılar programı</a>: teklif, proforma, yabancı dilde yazışma
      ve belge kontrolü üzerine Claude eğitimi, 3 ay destekle.
      Tek kişi <strong>45.000 TL</strong>, her ek kişi 20.000 TL (2-4 kişi). ${VAT}`,
    primary: { label: 'Programı İncele', href: '/programlar/ihracatcilar/' },
  },
  kamu: {
    heading: 'Kurumunuzda güvenli kullanımla başlayın.',
    body: `<a href="/programlar/kamu-kurumlari/">Kamu Kurumları semineri</a>: yarım günde veri sınıflandırması,
      KVKK ve doğrulama. 30 kişiye kadar <strong>45.000 TL</strong>, aynı kurumda ikinci seminer 35.000 TL.
      Abonelik gerekmez. ${VAT}`,
    primary: { label: 'Semineri İncele', href: '/programlar/kamu-kurumlari/' },
  },
  akademi: {
    heading: "Claude'u kendi araştırmanızla öğrenin.",
    body: `<a href="/programlar/akademisyenler/">Akademisyenler programı</a>: 3 hafta birebir; literatür,
      kaynak doğrulama, makale ve proje yazımı. Tek kişi <strong>30.000 TL</strong>,
      3-6 kişilik grup 75.000 TL. ${VAT}`,
    primary: { label: 'Programı İncele', href: '/programlar/akademisyenler/' },
  },
  sampiyon: {
    heading: "Claude'u kurumunuzda öğretecek kişiyi yetiştirelim.",
    body: `<a href="/programlar/ai-sampiyonu/">AI Şampiyonu ve Eğitmen Programı</a>: kurum içinde Claude'u öğretecek
      şampiyon (<strong>80.000 TL</strong>) ya da eğitimlerini Claude ile tasarlayan eğitmen
      (<strong>45.000 TL</strong>) için birebir program, 3 ay destekle. ${VAT}`,
    primary: { label: 'Programı İncele', href: '/programlar/ai-sampiyonu/' },
  },
  yonetici: {
    heading: 'Karar vermeden önce yapay zekayı anlayın.',
    body: `<a href="/programlar/ceo-brifing/">Yönetici AI Hazırlık</a>: yöneticiler için 3 saatlik tek oturum;
      yapay zeka nedir, ne değildir, şirketinize ne fayda sağlar. <strong>15.000 TL</strong>.
      30 gün içinde Bireysel ya da Kurumsal programa geçerseniz bu ücret düşülür. ${VAT}`,
    primary: { label: 'Oturumu İncele', href: '/programlar/ceo-brifing/' },
  },
};

const copy = VARIANTS[variant] ?? VARIANTS.default;
---

<aside class="retainer-cta" data-variant={variant}>
  <div class="retainer-cta__inner">
    <p class="retainer-cta__eyebrow">Zamana Claude Eğitimi</p>
    <h3>{copy.heading}</h3>
    <p>{intro} <Fragment set:html={copy.body} /></p>
    <div class="retainer-cta__actions">
      <a href={copy.primary.href} class="btn btn--primary">{copy.primary.label}</a>
      <a href="/iletisim/" class="btn btn--ghost">Görüşme Talep Et</a>
    </div>
    <p class="retainer-cta__secondary">
      Önce kendinizi ölçün: <a href="/hazirlik-degerlendirmesi/">Hazırlık Değerlendirmesi</a>
    </p>
  </div>
</aside>

<style>
  .retainer-cta p a {
    color: var(--c-gold-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .retainer-cta {
    margin: 3rem 0 1.5rem;
    border-radius: var(--r-lg);
    background: linear-gradient(160deg, var(--c-navy) 0%, var(--c-navy-deep) 100%);
    color: var(--c-text-light);
    border-top: 3px solid var(--c-gold);
    box-shadow: var(--sh-mid);
    overflow: hidden;
  }
  .retainer-cta__inner {
    padding: 2rem 1.75rem;
  }
  .retainer-cta__eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold-light);
    margin: 0 0 0.5rem;
  }
  .retainer-cta h3 {
    color: var(--c-white);
    font-size: 1.4rem;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }
  .retainer-cta p {
    color: var(--c-text-light-muted);
    margin: 0 0 1.25rem;
    line-height: 1.7;
  }
  .retainer-cta strong {
    color: var(--c-text-light);
    font-weight: 700;
  }
  .retainer-cta__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .retainer-cta .retainer-cta__secondary {
    margin: 1.1rem 0 0;
    font-size: 0.88rem;
  }
  .retainer-cta .retainer-cta__secondary a {
    color: var(--c-text-light);
    font-weight: 600;
    text-decoration-color: var(--c-gold);
  }
  .retainer-cta .retainer-cta__secondary a:hover {
    color: var(--c-gold-light);
  }
</style>
