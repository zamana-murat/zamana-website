---
/**
 * Turkish, code-driven hero animation for /claude/skills/ (replaces Anthropic's English video).
 * Scenario: the company's quotation method is saved as a skill (SKILL.md), then a one-line
 * request in a new chat produces a quote in the company format.
 * All elements live in the markup; the script only toggles data-step and types text.
 */
---

<div
  class="ca-skills"
  data-step="0"
  data-p1="Şirketimizin teklif yazım yöntemini bir skill olarak kaydet."
  data-p2="Bereket Gıda için 480.000 TL'lik ambalaj hattı teklifi hazırla."
  role="img"
  aria-label="Teklif yazım yöntemi bir skill olarak kaydediliyor, sonra tek cümlelik bir istekte Claude bu skill ile şirket formatında teklif hazırlıyor."
>
  <div class="sk__win" aria-hidden="true">
    <div class="sk__bar">
      <span class="sk__dot"></span><span class="sk__dot"></span><span class="sk__dot"></span>
      <span class="sk__bar-title">Yeni sohbet</span>
    </div>

    <div class="sk__stage">
      <!-- Scene A: save the method as a skill -->
      <div class="sk__scene sk__scene--a">
        <div class="sk__user">
          <p class="sk__bubble"><span class="sk__type" data-role="p1"></span><span class="sk__caret" data-for="1"></span></p>
          <span class="sk__file">
            <span class="sk__ficon sk__ficon--doc">W</span>
            teklif-ornegi.docx
          </span>
        </div>

        <div class="sk__slot">
          <div class="sk__status">
            <span class="sk__spark"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2v6M12 16v6M2 12h6M16 12h6M4.9 4.9l4.2 4.2M14.9 14.9l4.2 4.2M19.1 4.9l-4.2 4.2M9.1 14.9l-4.2 4.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
            <div>
              <p class="sk__status-title">Skill hazırlanıyor</p>
              <p class="sk__status-sub" data-role="sub1">Örnek teklif okunuyor</p>
            </div>
          </div>

          <div class="sk__card">
            <div class="sk__card-head">
              <span class="sk__cicon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5z"/><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5a1.5 1.5 0 0 1 1.5 1.5z"/></svg>
              </span>
              <span class="sk__cname"><strong>teklif-yazimi</strong><small>Skill · 2 dosya</small></span>
              <span class="sk__saved">Kaydedildi ✓</span>
            </div>
            <div class="sk__md">
              <p style="--i:0" class="sk__md-h"># Teklif yazım yöntemi</p>
              <p style="--i:1">1. Kapsam · 2. Fiyat · 3. Ödeme · 4. Geçerlilik</p>
              <p style="--i:2">Tutarlar TL, KDV ayrı satırda gösterilir</p>
              <p style="--i:3">Teklif geçerlilik süresi: 30 gün</p>
            </div>
            <div class="sk__chips">
              <span class="sk__chip">SKILL.md</span>
              <span class="sk__chip">teklif-sablonu.docx</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Scene B: a short request uses the skill -->
      <div class="sk__scene sk__scene--b">
        <div class="sk__user">
          <p class="sk__bubble"><span class="sk__type" data-role="p2"></span><span class="sk__caret" data-for="4"></span></p>
        </div>

        <div class="sk__status sk__status--b">
          <span class="sk__spark"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2v6M12 16v6M2 12h6M16 12h6M4.9 4.9l4.2 4.2M14.9 14.9l4.2 4.2M19.1 4.9l-4.2 4.2M9.1 14.9l-4.2 4.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
          <div>
            <p class="sk__status-title">Teklif hazırlanıyor</p>
            <p class="sk__status-sub" data-role="sub2">teklif-yazimi skill'i yükleniyor</p>
          </div>
        </div>
        <span class="sk__used">Kullanılan skill: teklif-yazimi</span>
      </div>

      <!-- Resulting document -->
      <div class="sk__doc">
        <div class="sk__doc-top">
          <span class="sk__doc-brand">Aydın Makine</span>
          <span class="sk__doc-no">Teklif no: 2026-118</span>
        </div>
        <p class="sk__doc-title">Ambalaj Hattı Fiyat Teklifi</p>
        <p class="sk__doc-to">Bereket Gıda A.Ş. · 14 Ekim 2026</p>
        <div class="sk__sec" style="--i:0"><span class="sk__sec-n">1</span><span class="sk__sec-t">Kapsam</span><span class="sk__sec-v">Ambalaj hattı, kurulum, eğitim</span></div>
        <div class="sk__sec" style="--i:1"><span class="sk__sec-n">2</span><span class="sk__sec-t">Fiyat</span><span class="sk__sec-v">480.000,00 TL + KDV 96.000,00 TL</span></div>
        <div class="sk__sec" style="--i:2"><span class="sk__sec-n">3</span><span class="sk__sec-t">Ödeme</span><span class="sk__sec-v">%40 peşin, %60 teslimde</span></div>
        <div class="sk__sec" style="--i:3"><span class="sk__sec-n">4</span><span class="sk__sec-t">Geçerlilik</span><span class="sk__sec-v">30 gün</span></div>
        <div class="sk__total" style="--i:4"><span>Toplam (KDV dahil)</span><strong>576.000,00 TL</strong></div>
        <span class="sk__tag">teklif-yazimi skill'i ile hazırlandı</span>
      </div>
    </div>
  </div>
</div>

<style>
  .ca-skills {
    --sk-ink: var(--c-navy);
    --sk-muted: var(--c-text-muted);
    --sk-line: var(--c-border);
    --sk-soft: #f3f1ea;
    width: 100%;
    aspect-ratio: 16 / 11;
    min-height: 320px;
    max-height: 520px;
    font-size: clamp(12px, 1.25vw, 15px);
  }
  .sk__win {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--c-white, #fff);
  }
  .sk__bar {
    display: flex; align-items: center; gap: 6px;
    padding: 0.7em 1em;
    border-bottom: 1px solid var(--sk-line);
  }
  .sk__dot { width: 9px; height: 9px; border-radius: 50%; background: #e2ded3; }
  .sk__bar-title { margin-left: 0.6em; font-size: 0.8em; color: var(--sk-muted); font-weight: 600; }
  .sk__stage { position: relative; flex: 1; overflow: hidden; }

  .sk__scene {
    position: absolute; inset: 0; padding: 1.3em 1.5em;
    opacity: 0; transition: opacity .4s;
  }

  /* chat */
  .sk__user { display: flex; flex-direction: column; align-items: flex-end; gap: 0.45em; opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s; }
  .sk__bubble {
    margin: 0; max-width: 82%;
    background: var(--sk-soft); color: var(--sk-ink);
    padding: 0.7em 1em; border-radius: 14px 14px 4px 14px;
    line-height: 1.45; min-height: 1.45em;
  }
  .sk__caret { display: none; width: 2px; height: 1em; margin-left: 2px; vertical-align: -0.15em; background: var(--sk-ink); animation: sk-blink 1s steps(1) infinite; }
  .ca-skills[data-typing="1"] .sk__caret[data-for="1"],
  .ca-skills[data-typing="2"] .sk__caret[data-for="4"] { display: inline-block; }
  .sk__file {
    display: inline-flex; align-items: center; gap: 0.45em;
    font-size: 0.8em; font-weight: 600; color: var(--sk-ink);
    border: 1px solid var(--sk-line); border-radius: 8px; padding: 0.3em 0.6em 0.3em 0.35em; background: #fff;
  }
  .sk__ficon { width: 1.5em; height: 1.5em; border-radius: 4px; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 0.85em; flex-shrink: 0; }
  .sk__ficon--doc { background: #2b5797; }

  .sk__slot { display: grid; margin-top: 1.2em; }
  .sk__slot > * { grid-area: 1 / 1; }
  .sk__status { display: flex; gap: 0.7em; align-items: flex-start; align-self: start; opacity: 0; transition: opacity .3s; }
  .sk__status--b { margin-top: 1.2em; }
  .sk__spark { color: var(--c-gold); display: inline-flex; margin-top: 0.1em; animation: sk-spin 1.6s linear infinite; }
  .sk__status-title { margin: 0; font-weight: 700; color: var(--sk-ink); }
  .sk__status-sub { margin: 0.15em 0 0; color: var(--sk-muted); font-size: 0.9em; }

  /* skill card */
  .sk__card {
    border: 1px solid var(--sk-line); border-radius: 12px; padding: 0.9em 1em;
    background: #fff; box-shadow: 0 8px 22px rgba(15, 40, 85, .08);
    opacity: 0; transform: translateY(10px); transition: opacity .4s, transform .4s;
  }
  .sk__card-head { display: flex; align-items: center; gap: 0.75em; }
  .sk__cicon { width: 2.3em; height: 2.3em; border-radius: 8px; background: var(--c-navy); color: var(--c-gold); display: grid; place-items: center; flex-shrink: 0; }
  .sk__cname strong { display: block; color: var(--sk-ink); }
  .sk__cname small { color: var(--sk-muted); font-size: 0.8em; }
  .sk__saved { margin-left: auto; font-size: 0.78em; font-weight: 700; color: var(--c-gold-text); border: 1px solid var(--c-border-gold); background: var(--c-bg-subtle); border-radius: 999px; padding: 0.2em 0.65em; white-space: nowrap; }
  .sk__md {
    margin: 0.8em 0 0; padding: 0.65em 0.85em; border-radius: 8px;
    background: var(--c-cream); border: 1px solid var(--sk-line);
    font-size: 0.82em; line-height: 1.55; color: var(--sk-ink);
  }
  .sk__md p { margin: 0; opacity: 0; transform: translateX(-6px); transition: opacity .3s calc(var(--i) * 220ms + 250ms), transform .3s calc(var(--i) * 220ms + 250ms); }
  .sk__md-h { font-weight: 800; }
  .sk__chips { display: flex; gap: 0.5em; margin-top: 0.75em; flex-wrap: wrap; }
  .sk__chip { font-size: 0.75em; font-weight: 600; color: var(--sk-ink); background: var(--sk-soft); border-radius: 6px; padding: 0.25em 0.6em; }

  /* scene B */
  .sk__used {
    display: inline-block; margin-top: 0.9em; margin-left: 1.7em;
    font-size: 0.74em; font-weight: 700; color: var(--c-gold-text);
    border: 1px solid var(--c-border-gold); background: var(--c-bg-subtle);
    border-radius: 999px; padding: 0.25em 0.75em;
    opacity: 0; transition: opacity .3s;
  }

  /* document */
  .sk__doc {
    position: absolute; inset: 1.1em 1.5em;
    background: #fff; border: 1px solid var(--sk-line); border-radius: 10px;
    padding: 1.1em 1.4em; display: flex; flex-direction: column;
    opacity: 0; transform: translateY(16px) scale(.98);
    transition: opacity .45s, transform .45s;
    box-shadow: 0 12px 30px rgba(15, 40, 85, .16);
  }
  .sk__doc-top { display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.6em; border-bottom: 2px solid var(--c-gold); }
  .sk__doc-brand { font-weight: 800; color: var(--c-navy); letter-spacing: .02em; }
  .sk__doc-no { font-size: 0.72em; color: var(--sk-muted); font-weight: 600; }
  .sk__doc-title { margin: 0.8em 0 0; font-size: 1.35em; font-weight: 800; color: var(--c-navy); line-height: 1.15; }
  .sk__doc-to { margin: 0.25em 0 0.8em; font-size: 0.8em; color: var(--sk-muted); }
  .sk__sec {
    display: grid; grid-template-columns: 1.7em 5.2em 1fr; align-items: baseline; gap: 0.4em;
    padding: 0.5em 0; border-top: 1px solid var(--sk-line); font-size: 0.86em;
    opacity: 0; transform: translateY(6px);
    transition: opacity .3s calc(var(--i) * 200ms + 200ms), transform .3s calc(var(--i) * 200ms + 200ms);
  }
  .sk__sec-n { width: 1.5em; height: 1.5em; border-radius: 50%; background: var(--c-navy); color: #fff; font-size: 0.8em; font-weight: 800; display: grid; place-items: center; }
  .sk__sec-t { font-weight: 800; color: var(--c-navy); }
  .sk__sec-v { color: var(--sk-ink); }
  .sk__total {
    display: flex; justify-content: space-between; align-items: center; margin-top: 0.4em;
    padding: 0.55em 0.8em; border-radius: 8px; background: var(--c-bg-subtle); border: 1px solid var(--c-border-gold);
    font-size: 0.86em; color: var(--c-navy); font-weight: 700;
    opacity: 0; transform: translateY(6px);
    transition: opacity .3s calc(var(--i) * 200ms + 200ms), transform .3s calc(var(--i) * 200ms + 200ms);
  }
  .sk__total strong { font-weight: 800; }
  .sk__tag {
    margin-top: auto; align-self: flex-start;
    font-size: 0.7em; font-weight: 700; color: var(--c-navy); background: var(--c-gold);
    padding: 0.28em 0.7em; border-radius: 999px;
  }

  /* step states */
  .ca-skills[data-step="1"] .sk__scene--a,
  .ca-skills[data-step="2"] .sk__scene--a,
  .ca-skills[data-step="3"] .sk__scene--a { opacity: 1; }
  .ca-skills:not([data-step="0"]) .sk__scene--a .sk__user { opacity: 1; transform: none; }
  .ca-skills[data-step="2"] .sk__scene--a .sk__status { opacity: 1; }
  .ca-skills[data-step="3"] .sk__card { opacity: 1; transform: none; }
  .ca-skills[data-step="3"] .sk__md p { opacity: 1; transform: none; }

  .ca-skills[data-step="4"] .sk__scene--b,
  .ca-skills[data-step="5"] .sk__scene--b,
  .ca-skills[data-step="6"] .sk__scene--b { opacity: 1; }
  .ca-skills[data-step="4"] .sk__scene--b .sk__user,
  .ca-skills[data-step="5"] .sk__scene--b .sk__user,
  .ca-skills[data-step="6"] .sk__scene--b .sk__user { opacity: 1; transform: none; }
  .ca-skills[data-step="5"] .sk__status--b,
  .ca-skills[data-step="5"] .sk__used,
  .ca-skills[data-step="6"] .sk__status--b,
  .ca-skills[data-step="6"] .sk__used { opacity: 1; }
  .ca-skills[data-step="6"] .sk__doc { opacity: 1; transform: none; }
  .ca-skills[data-step="6"] .sk__sec,
  .ca-skills[data-step="6"] .sk__total { opacity: 1; transform: none; }
  .ca-skills[data-step="7"] .sk__win { opacity: 0; transition: opacity .5s; }

  @keyframes sk-blink { 50% { opacity: 0; } }
  @keyframes sk-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .ca-skills *, .ca-skills *::before, .ca-skills *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const SUBS1 = ['Örnek teklif okunuyor', 'Yöntem adım adım yazılıyor', 'SKILL.md dosyası hazırlanıyor'];
  const SUBS2 = ["teklif-yazimi skill'i yükleniyor", 'Şirket formatında yazılıyor'];

  function setup(root: HTMLElement) {
    const p1 = root.dataset.p1 || '';
    const p2 = root.dataset.p2 || '';
    const el = (r: string) => root.querySelector<HTMLElement>(`[data-role="${r}"]`)!;
    const p1El = el('p1'), p2El = el('p2'), sub1 = el('sub1'), sub2 = el('sub2');
    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const type = (node: HTMLElement, text: string, start: number, speed: number) => {
      for (let i = 0; i <= text.length; i++) at(start + i * speed, () => { node.textContent = text.slice(0, i); });
      return start + text.length * speed;
    };
    const step = (n: number) => { root.dataset.step = String(n); };

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      p1El.textContent = ''; p2El.textContent = '';
      sub1.textContent = SUBS1[0]; sub2.textContent = SUBS2[0];
      delete root.dataset.typing; step(0);
    };

    const cycle = () => {
      reset();
      // Scene A: save the method as a skill
      at(300, () => { step(1); root.dataset.typing = '1'; });
      const typed1 = type(p1El, p1, 500, 22);
      at(typed1 + 300, () => { delete root.dataset.typing; step(2); });
      at(typed1 + 1400, () => { sub1.textContent = SUBS1[1]; });
      at(typed1 + 2400, () => { sub1.textContent = SUBS1[2]; });
      const t3 = typed1 + 3400;
      at(t3, () => step(3));
      // Scene B: a short request uses the skill
      const t4 = t3 + 3000;
      at(t4, () => { step(4); root.dataset.typing = '2'; });
      const typed2 = type(p2El, p2, t4 + 400, 22);
      at(typed2 + 300, () => { delete root.dataset.typing; step(5); });
      at(typed2 + 1500, () => { sub2.textContent = SUBS2[1]; });
      const t6 = typed2 + 2800;
      at(t6, () => step(6));
      at(t6 + 2900, () => step(7));
      at(t6 + 3500, () => { if (running) cycle(); });
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      p2El.textContent = p2;
      step(6);
      return;
    }

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !running) { running = true; cycle(); }
      else if (!visible && running) { running = false; reset(); }
    }, { threshold: 0.25 });
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('.ca-skills').forEach(setup);
</script>
