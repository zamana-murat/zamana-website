---
/**
 * Turkish, code-driven hero animation for /claude/ (replaces Anthropic's English video).
 * Scenario: user asks for a board deck from a Q3 sales spreadsheet; Claude works,
 * delivers 8 slides, fixes a headline to match the chart, hands over the files.
 * All elements live in the markup; the script only toggles data-step and types text.
 */
const PROMPT = "Ekteki 3. çeyrek satış raporundan cuma günkü yönetim kurulu toplantısı için kısa bir sunum hazırla.";
const bars = [
  { label: 'Marmara', value: 60 },
  { label: 'Ege', value: 72 },
  { label: 'İç Anadolu', value: 44 },
  { label: 'İhracat', value: 92 },
];
---

<div
  class="cd"
  data-step="0"
  data-prompt={PROMPT}
  role="img"
  aria-label="Claude'a Türkçe görev veriliyor: satış raporundan yönetim kurulu sunumu ve özet rapor hazırlanıyor."
>
  <div class="cd__win" aria-hidden="true">
    <div class="cd__bar">
      <span class="cd__dot"></span><span class="cd__dot"></span><span class="cd__dot"></span>
      <span class="cd__bar-title">Yeni sohbet</span>
    </div>

    <div class="cd__stage">
      <!-- Chat column -->
      <div class="cd__chat">
        <div class="cd__user">
          <p class="cd__bubble"><span class="cd__type" data-role="prompt"></span><span class="cd__caret"></span></p>
          <span class="cd__file">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="2" y="1.5" width="12" height="13" rx="2" fill="#1d6f42"/><path d="M5 5l6 6M11 5l-6 6" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
            Q3-satis.xlsx
          </span>
        </div>

        <div class="cd__status">
          <span class="cd__spark"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2v6M12 16v6M2 12h6M16 12h6M4.9 4.9l4.2 4.2M14.9 14.9l4.2 4.2M19.1 4.9l-4.2 4.2M9.1 14.9l-4.2 4.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
          <div>
            <p class="cd__status-title">Sunum hazırlanıyor</p>
            <p class="cd__status-sub" data-role="sub">Excel'deki bölge satışları okunuyor</p>
          </div>
        </div>

        <div class="cd__done">
          <p class="cd__done-text"><span class="cd__type" data-role="done"></span></p>
          <div class="cd__thumbs">
            {Array.from({ length: 8 }).map((_, i) => (
              <span class="cd__thumb" style={`--i:${i}`}><span></span><span></span></span>
            ))}
          </div>
        </div>
      </div>

      <!-- Slide view -->
      <div class="cd__slide">
        <p class="cd__slide-eyebrow">3. çeyrek satış özeti</p>
        <p class="cd__slide-title">
          Büyüme <span class="cd__edit"><span class="cd__type" data-role="edit">Ege'den geldi.</span></span>
        </p>
        <div class="cd__chart">
          {bars.map((b, i) => (
            <div class="cd__col" style={`--v:${b.value}; --i:${i}`}>
              <span class={`cd__barfill${b.label === 'İhracat' ? ' cd__barfill--hi' : ''}`}></span>
              <span class="cd__lbl">{b.label}</span>
            </div>
          ))}
        </div>
        <span class="cd__tag">Claude düzenliyor</span>
        <p class="cd__slide-foot">Yönetim Kurulu · Slayt 2 / 8</p>
      </div>

      <!-- Files -->
      <div class="cd__files">
        <p class="cd__files-title">Dosyalarınız hazır</p>
        <div class="cd__filecard" style="--i:0">
          <span class="cd__ficon cd__ficon--ppt">P</span>
          <span><strong>Yönetim Kurulu Sunumu.pptx</strong><small>8 slayt</small></span>
          <span class="cd__check">✓</span>
        </div>
        <div class="cd__filecard" style="--i:1">
          <span class="cd__ficon cd__ficon--doc">W</span>
          <span><strong>3. Çeyrek Özet Raporu.docx</strong><small>2 sayfa</small></span>
          <span class="cd__check">✓</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cd {
    --cd-ink: var(--c-navy);
    --cd-muted: var(--c-text-muted);
    --cd-line: var(--c-border);
    --cd-soft: #f3f1ea;
    width: 100%;
    aspect-ratio: 16 / 11;
    min-height: 320px;
    max-height: 520px;
    font-size: clamp(12px, 1.25vw, 15px);
  }
  .cd__win {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--c-white, #fff);
  }
  .cd__bar {
    display: flex; align-items: center; gap: 6px;
    padding: 0.7em 1em;
    border-bottom: 1px solid var(--cd-line);
  }
  .cd__dot { width: 9px; height: 9px; border-radius: 50%; background: #e2ded3; }
  .cd__bar-title { margin-left: 0.6em; font-size: 0.8em; color: var(--cd-muted); font-weight: 600; }
  .cd__stage { position: relative; flex: 1; overflow: hidden; padding: 1.4em 1.5em; }

  /* chat */
  .cd__user { display: flex; flex-direction: column; align-items: flex-end; gap: 0.45em; opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s; }
  .cd__bubble {
    margin: 0; max-width: 82%;
    background: var(--cd-soft); color: var(--cd-ink);
    padding: 0.75em 1em; border-radius: 14px 14px 4px 14px;
    line-height: 1.45; min-height: 1.45em;
  }
  .cd__caret { display: inline-block; width: 2px; height: 1em; margin-left: 2px; vertical-align: -0.15em; background: var(--cd-ink); animation: cd-blink 1s steps(1) infinite; }
  .cd__file {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-size: 0.8em; font-weight: 600; color: var(--cd-ink);
    border: 1px solid var(--cd-line); border-radius: 8px; padding: 0.3em 0.6em; background: #fff;
  }
  .cd__status { display: flex; gap: 0.7em; align-items: flex-start; margin-top: 1.3em; opacity: 0; transition: opacity .3s; }
  .cd__spark { color: var(--c-gold); display: inline-flex; margin-top: 0.1em; animation: cd-spin 1.6s linear infinite; }
  .cd__status-title { margin: 0; font-weight: 700; color: var(--cd-ink); }
  .cd__status-sub { margin: 0.15em 0 0; color: var(--cd-muted); font-size: 0.9em; transition: opacity .25s; }
  .cd__done { margin-top: 1.3em; opacity: 0; transition: opacity .3s; }
  .cd__done-text { margin: 0 0 0.8em; font-weight: 700; color: var(--cd-ink); min-height: 1.4em; }
  .cd__thumbs { display: grid; grid-template-columns: repeat(8, 1fr); gap: 0.4em; }
  .cd__thumb {
    aspect-ratio: 16 / 10; border-radius: 4px; background: var(--c-navy);
    display: flex; flex-direction: column; justify-content: center; gap: 3px; padding: 0 12%;
    opacity: 0; transform: scale(.9);
    transition: opacity .3s calc(var(--i) * 70ms), transform .3s calc(var(--i) * 70ms);
  }
  .cd__thumb span { height: 2px; border-radius: 2px; background: rgba(255,255,255,.55); }
  .cd__thumb span:last-child { width: 60%; background: var(--c-gold); }

  /* slide */
  .cd__slide {
    position: absolute; inset: 1.1em 1.3em;
    background: var(--c-navy); color: #fff; border-radius: 10px;
    padding: 1.4em 1.6em 1.1em; display: flex; flex-direction: column;
    opacity: 0; transform: translateY(16px) scale(.98);
    transition: opacity .45s, transform .45s;
    box-shadow: 0 12px 30px rgba(15, 40, 85, .25);
  }
  .cd__slide-eyebrow { margin: 0; font-size: 0.72em; letter-spacing: .14em; text-transform: uppercase; color: var(--c-gold); font-weight: 700; }
  .cd__slide-title { margin: 0.35em 0 0; font-size: 1.7em; font-weight: 800; line-height: 1.15; }
  .cd__edit { position: relative; border-radius: 3px; transition: background .2s; }
  .cd[data-edit="sel"] .cd__edit { background: rgba(201, 168, 76, .55); }
  .cd__chart { flex: 1; display: flex; align-items: flex-end; gap: 7%; padding: 1em 4% 0; min-height: 0; }
  .cd__col { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 0.35em; }
  .cd__barfill {
    width: 100%; border-radius: 4px 4px 0 0; background: rgba(255,255,255,.35);
    height: 0; transition: height .7s cubic-bezier(.2,.8,.2,1) calc(var(--i) * 90ms);
  }
  .cd__barfill--hi { background: var(--c-gold); }
  .cd__lbl { font-size: 0.72em; color: rgba(255,255,255,.75); white-space: nowrap; }
  .cd__tag {
    position: absolute; top: 1.2em; right: 1.2em;
    font-size: 0.7em; font-weight: 700; color: var(--c-navy); background: var(--c-gold);
    padding: 0.25em 0.6em; border-radius: 999px; opacity: 0; transition: opacity .25s;
  }
  .cd[data-edit] .cd__tag { opacity: 1; }
  .cd__slide-foot { margin: 0.8em 0 0; font-size: 0.7em; color: rgba(255,255,255,.55); }

  /* files */
  .cd__files {
    position: absolute; inset: 0; padding: 1.6em 1.5em;
    background: #fff; display: flex; flex-direction: column; justify-content: center; gap: 0.8em;
    opacity: 0; transition: opacity .4s;
  }
  .cd__files-title { margin: 0 0 0.2em; font-weight: 800; color: var(--cd-ink); font-size: 1.15em; }
  .cd__filecard {
    display: flex; align-items: center; gap: 0.8em;
    border: 1px solid var(--cd-line); border-radius: 10px; padding: 0.8em 1em;
    opacity: 0; transform: translateY(8px);
    transition: opacity .35s calc(var(--i) * 180ms), transform .35s calc(var(--i) * 180ms);
  }
  .cd__filecard strong { display: block; color: var(--cd-ink); font-size: 0.95em; }
  .cd__filecard small { color: var(--cd-muted); font-size: 0.8em; }
  .cd__ficon { width: 2.2em; height: 2.2em; border-radius: 6px; display: grid; place-items: center; color: #fff; font-weight: 800; flex-shrink: 0; }
  .cd__ficon--ppt { background: #c4502b; }
  .cd__ficon--doc { background: #2b5797; }
  .cd__check { margin-left: auto; color: var(--c-gold-text); font-weight: 800; }

  /* step states */
  .cd:not([data-step="0"]) .cd__user { opacity: 1; transform: none; }
  .cd[data-step="2"] .cd__status { opacity: 1; }
  .cd[data-step="3"] .cd__done,
  .cd[data-step="4"] .cd__done { opacity: 1; }
  .cd[data-step="3"] .cd__thumb,
  .cd[data-step="4"] .cd__thumb { opacity: 1; transform: none; }
  .cd[data-step="4"] .cd__slide,
  .cd[data-step="5"] .cd__slide { opacity: 1; transform: none; }
  .cd[data-step="4"] .cd__barfill,
  .cd[data-step="5"] .cd__barfill { height: calc(var(--v) * 1%); }
  .cd[data-step="5"] .cd__files { opacity: 1; }
  .cd[data-step="5"] .cd__filecard { opacity: 1; transform: none; }
  .cd[data-step="6"] .cd__win { opacity: 0; transition: opacity .5s; }
  .cd:not([data-typing]) .cd__caret { display: none; }

  @keyframes cd-blink { 50% { opacity: 0; } }
  @keyframes cd-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .cd *, .cd *::before { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const SUBS = [
    "Excel'deki bölge satışları okunuyor",
    'Grafikler hazırlanıyor',
    'Başlıklar şirket diline göre yazılıyor',
  ];
  const DONE = 'Sunumunuz hazır: 8 slayt.';
  const EDIT_FROM = "Ege'den geldi.";
  const EDIT_TO = 'ihracattan geldi.';

  function setup(root: HTMLElement) {
    const prompt = root.dataset.prompt || '';
    const el = (r: string) => root.querySelector<HTMLElement>(`[data-role="${r}"]`)!;
    const pEl = el('prompt'), sub = el('sub'), done = el('done'), edit = el('edit');
    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const type = (node: HTMLElement, text: string, start: number, speed: number) => {
      for (let i = 0; i <= text.length; i++) at(start + i * speed, () => { node.textContent = text.slice(0, i); });
      return start + text.length * speed;
    };
    const step = (n: number) => { root.dataset.step = String(n); };

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      pEl.textContent = ''; done.textContent = ''; edit.textContent = EDIT_FROM; sub.textContent = SUBS[0];
      delete root.dataset.edit; delete root.dataset.typing; step(0);
    };

    const cycle = () => {
      reset();
      at(300, () => { step(1); root.dataset.typing = '1'; });
      const typed = type(pEl, prompt, 500, 24);
      at(typed + 300, () => { delete root.dataset.typing; step(2); });
      at(typed + 1400, () => { sub.textContent = SUBS[1]; });
      at(typed + 2500, () => { sub.textContent = SUBS[2]; });
      const t3 = typed + 3600;
      at(t3, () => step(3));
      type(done, DONE, t3 + 150, 28);
      const t4 = t3 + 1900;
      at(t4, () => step(4));
      at(t4 + 1700, () => { root.dataset.edit = 'sel'; });
      at(t4 + 2400, () => { root.dataset.edit = 'type'; edit.textContent = ''; });
      const t4e = type(edit, EDIT_TO, t4 + 2450, 45);
      at(t4e + 900, () => { delete root.dataset.edit; });
      const t5 = t4e + 1500;
      at(t5, () => step(5));
      at(t5 + 2600, () => step(6));
      at(t5 + 3200, () => { if (running) cycle(); });
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      pEl.textContent = prompt; done.textContent = DONE; edit.textContent = EDIT_TO;
      step(4);
      return;
    }

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !running) { running = true; cycle(); }
      else if (!visible && running) { running = false; reset(); }
    }, { threshold: 0.25 });
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('.cd').forEach(setup);
</script>
