<style>
  .ca-sci {
    --ink: var(--c-navy);
    --muted: var(--c-text-muted);
    --line: var(--c-border);
    --soft: #f3f1ea;
    width: 100%;
    aspect-ratio: 16 / 11;
    min-height: 320px;
    max-height: 520px;
    font-size: clamp(12px, 1.25vw, 15px);
  }
  .ca-sci__win { height: 100%; display: flex; flex-direction: column; background: var(--c-white, #fff); }
  .ca-sci__bar { display: flex; align-items: center; gap: 6px; padding: 0.7em 1em; border-bottom: 1px solid var(--line); }
  .ca-sci__dot { width: 9px; height: 9px; border-radius: 50%; background: #e2ded3; }
  .ca-sci__bar-title { margin-left: 0.6em; font-size: 0.8em; color: var(--muted); font-weight: 600; }
  .ca-sci__sample {
    margin-left: auto; font-size: 0.68em; font-weight: 700; color: var(--c-gold-text);
    border: 1px solid var(--c-border-gold, rgba(201,168,76,.3)); border-radius: 999px; padding: 0.15em 0.65em;
  }
  .ca-sci__stage { position: relative; flex: 1; overflow: hidden; display: grid; grid-template-columns: 41% 1fr; }
  .ca-sci p { margin: 0; }

  /* chat */
  .ca-sci__chat { padding: 1.2em 1em 1.2em 1.3em; min-width: 0; }
  .ca-sci__user { display: flex; flex-direction: column; align-items: flex-end; gap: 0.45em; opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s; }
  .ca-sci__bubble {
    max-width: 100%; background: var(--soft); color: var(--ink);
    padding: 0.7em 0.9em; border-radius: 14px 14px 4px 14px; font-size: 0.86em;
    line-height: 1.45; min-height: 1.45em;
  }
  .ca-sci__caret { display: inline-block; width: 2px; height: 1em; margin-left: 2px; vertical-align: -0.15em; background: var(--ink); animation: ca-sci-blink 1s steps(1) infinite; }
  .ca-sci__file {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-size: 0.74em; font-weight: 600; color: var(--ink);
    border: 1px solid var(--line); border-radius: 8px; padding: 0.3em 0.6em; background: #fff;
  }
  .ca-sci__respond { display: grid; margin-top: 1.1em; }
  .ca-sci__status, .ca-sci__done { grid-area: 1 / 1; opacity: 0; transition: opacity .3s; }
  .ca-sci__status { display: flex; gap: 0.7em; align-items: flex-start; }
  .ca-sci__spark { color: var(--c-gold); display: inline-flex; margin-top: 0.1em; animation: ca-sci-spin 1.6s linear infinite; }
  .ca-sci__status-title { font-weight: 700; color: var(--ink); font-size: 0.92em; }
  .ca-sci__status-sub { margin-top: 0.15em !important; color: var(--muted); font-size: 0.8em; }
  .ca-sci__done-text { font-weight: 700; color: var(--ink); font-size: 0.88em; line-height: 1.45; min-height: 1.4em; }

  /* right panel */
  .ca-sci__panel { position: relative; opacity: 0; transition: opacity .35s; margin: 0.9em 1.1em 0.9em 0; border: 1px solid var(--line); border-radius: 10px; background: #fff; overflow: hidden; min-width: 0; }
  .ca-sci__panel-title { font-size: 0.74em; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--c-gold-text); }
  .ca-sci__panel-title span { letter-spacing: 0; text-transform: none; font-weight: 600; color: var(--muted); }
  .ca-sci__log, .ca-sci__fig, .ca-sci__prov { position: absolute; inset: 0; padding: 0.9em 1em; }
  .ca-sci__log { opacity: 0; transition: opacity .35s; }
  .ca-sci__logrow { display: flex; align-items: flex-start; gap: 0.7em; margin-top: 0.85em; opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .3s; }
  .ca-sci__logrow strong { display: block; font-size: 0.86em; color: var(--ink); }
  .ca-sci__logrow small { display: block; font-size: 0.74em; color: var(--muted); margin-top: 0.1em; }
  .ca-sci__tick { flex-shrink: 0; width: 1.5em; height: 1.5em; border-radius: 50%; background: #e6f2ea; color: #1d6f42; display: grid; place-items: center; font-size: 0.78em; font-weight: 800; }
  .ca-sci__logrow--on { opacity: 1; transform: none; }

  .ca-sci__fig { opacity: 0; transition: opacity .4s; }
  .ca-sci__svg { display: block; width: 100%; height: auto; margin: 0.3em auto 0; transition: width .5s; }
  .ca-sci__axis { font-size: 7px; fill: rgba(15,40,85,.5); font-weight: 600; }
  .ca-sci__svg circle { opacity: 0; transition: opacity .35s calc(var(--i) * 4ms); }
  .ca-sci__lab {
    font-size: 9px; font-weight: 600; fill: var(--muted); text-anchor: middle;
    paint-order: stroke; stroke: #fff; stroke-width: 0; stroke-linejoin: round;
    transition: font-size .4s, fill .3s, stroke-width .3s; opacity: 0;
  }
  .ca-sci__note {
    position: absolute; left: 1em; right: 1em; bottom: 0.9em;
    display: flex; align-items: flex-start; gap: 0.6em;
    background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 0.55em 0.75em;
    box-shadow: 0 6px 18px rgba(15,40,85,.14);
    opacity: 0; transform: translateY(8px); transition: opacity .3s, transform .3s;
  }
  .ca-sci__note-n { flex-shrink: 0; width: 1.5em; height: 1.5em; border-radius: 50%; background: var(--c-navy); color: #fff; display: grid; place-items: center; font-size: 0.74em; font-weight: 800; }
  .ca-sci__note-text { font-size: 0.8em; color: var(--ink); line-height: 1.4; min-height: 1.4em; }
  .ca-sci__caret--note { height: 0.95em; }

  .ca-sci__prov {
    top: auto; padding: 0.8em 1em 0.9em; background: #fff; border-top: 1px solid var(--line);
    box-shadow: 0 -8px 20px rgba(15,40,85,.1);
    opacity: 0; transform: translateY(16px); transition: opacity .4s, transform .4s;
  }
  .ca-sci__prov-title { font-size: 0.86em; font-weight: 800; color: var(--ink); margin-bottom: 0.4em !important; }
  .ca-sci__prov-title span { font-size: 0.8em; font-weight: 700; color: #1d6f42; background: #e6f2ea; border-radius: 999px; padding: 0.1em 0.6em; margin-left: 0.4em; }
  .ca-sci__prov-row { display: flex; gap: 0.8em; padding: 0.28em 0; border-top: 1px solid var(--line); font-size: 0.74em; color: var(--ink); }
  .ca-sci__prov-row b { flex: 0 0 8.6em; white-space: nowrap; color: var(--muted); font-weight: 700; }
  .ca-sci__prov-row span { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ca-sci__prov-row--ok span { color: #1d6f42; }

  /* step states */
  .ca-sci:not([data-step="0"]) .ca-sci__user { opacity: 1; transform: none; }
  .ca-sci:not([data-step="0"]):not([data-step="1"]) .ca-sci__panel { opacity: 1; }
  .ca-sci[data-step="2"] .ca-sci__status { opacity: 1; }
  .ca-sci[data-step="2"] .ca-sci__log { opacity: 1; }
  .ca-sci:not([data-step="0"]):not([data-step="1"]):not([data-step="2"]) .ca-sci__done { opacity: 1; }
  .ca-sci:not([data-step="0"]):not([data-step="1"]):not([data-step="2"]) .ca-sci__fig { opacity: 1; }
  .ca-sci:not([data-step="0"]):not([data-step="1"]):not([data-step="2"]) .ca-sci__svg circle { opacity: 0.88; }
  .ca-sci:not([data-step="0"]):not([data-step="1"]):not([data-step="2"]) .ca-sci__lab { opacity: 1; }
  .ca-sci[data-edit="note"] .ca-sci__note { opacity: 1; transform: none; }
  .ca-sci[data-edit="sent"] .ca-sci__lab { font-size: 13px; font-weight: 800; fill: var(--c-navy); stroke-width: 3px; }
  .ca-sci[data-step="5"] .ca-sci__svg,
  .ca-sci[data-step="6"] .ca-sci__svg { width: 66%; }
  .ca-sci[data-step="5"] .ca-sci__prov,
  .ca-sci[data-step="6"] .ca-sci__prov { opacity: 1; transform: none; }
  .ca-sci[data-step="6"] .ca-sci__win { opacity: 0; transition: opacity .5s; }
  .ca-sci__caret--p, .ca-sci__caret--note { display: none; }
  .ca-sci[data-typing="prompt"] .ca-sci__caret--p { display: inline-block; }
  .ca-sci[data-typing="note"] .ca-sci__caret--note { display: inline-block; }

  @keyframes ca-sci-blink { 50% { opacity: 0; } }
  @keyframes ca-sci-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .ca-sci *, .ca-sci *::before { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const PROMPT = 'Laboratuvarın tek hücre verisini kümele, hücre tiplerini işaretle ve literatürle karşılaştır.';
  const SUBS = ['Veri okunuyor', 'Hücreler kümeleniyor', 'Literatür taranıyor'];
  const DONE = 'Analiz bitti: 7 küme, 5 hücre tipi. Ön bulgu: 3. küme NK hücrelerine benziyor.';
  const NOTE = 'Etiketler küçük, büyütür müsünüz?';

  function setup(root) {
    const el = (r) => root.querySelector('[data-role="' + r + '"]');
    const pEl = el('prompt'), sub = el('sub'), done = el('done'), note = el('note');
    const rows = root.querySelectorAll('.ca-sci__logrow');
    let timers = [];
    let running = false;
    const at = (ms, fn) => timers.push(window.setTimeout(fn, ms));
    const type = (node, text, start, speed) => {
      for (let i = 0; i <= text.length; i++) at(start + i * speed, () => { node.textContent = text.slice(0, i); });
      return start + text.length * speed;
    };
    const step = (n) => { root.dataset.step = String(n); };
    const rowsOn = (n) => rows.forEach((r, i) => r.classList.toggle('ca-sci__logrow--on', i < n));

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      pEl.textContent = ''; done.textContent = ''; note.textContent = ''; sub.textContent = SUBS[0];
      rowsOn(0);
      delete root.dataset.edit; delete root.dataset.typing; step(0);
    };

    const cycle = () => {
      reset();
      at(300, () => { step(1); root.dataset.typing = 'prompt'; });
      const typed = type(pEl, PROMPT, 500, 18);
      at(typed + 300, () => { delete root.dataset.typing; step(2); });
      at(typed + 700, () => rowsOn(1));
      at(typed + 1400, () => { rowsOn(2); sub.textContent = SUBS[1]; });
      at(typed + 2100, () => rowsOn(3));
      at(typed + 2800, () => { rowsOn(4); sub.textContent = SUBS[2]; });
      const t3 = typed + 3600;
      at(t3, () => step(3));
      const doneEnd = type(done, DONE, t3 + 700, 20);
      const t4 = Math.max(doneEnd + 500, t3 + 2600);
      at(t4, () => { step(4); root.dataset.edit = 'note'; root.dataset.typing = 'note'; });
      const noteEnd = type(note, NOTE, t4 + 400, 32);
      at(noteEnd + 600, () => { delete root.dataset.typing; root.dataset.edit = 'sent'; });
      const t5 = noteEnd + 1700;
      at(t5, () => step(5));
      at(t5 + 2800, () => step(6));
      at(t5 + 3400, () => { if (running) cycle(); });
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      pEl.textContent = PROMPT; done.textContent = DONE;
      rowsOn(4);
      root.dataset.edit = 'sent';
      step(5);
      return;
    }

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !running) { running = true; cycle(); }
      else if (!visible && running) { running = false; reset(); }
    }, { threshold: 0.25 });
    io.observe(root);
  }

  document.querySelectorAll('.ca-sci').forEach(setup);
</script>
