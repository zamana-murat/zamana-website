---
/**
 * Turkish, code-driven hero animation for /claude/science/ (replaces Anthropic's English video).
 * Scenario: a researcher (fictional lab, fictional data) asks for clustering + cell-type labelling
 * of single-cell data and a literature comparison; Claude runs the steps, a figure appears,
 * the researcher asks for larger labels, and the figure's provenance (code, environment) is shown.
 * All elements live in the markup; the script only toggles data-step and types text.
 */
---

<div
  class="ca-sci"
  data-step="0"
  role="img"
  aria-label="Claude Science'ta bir araştırmacı tek hücre verisini kümelemesini istiyor: analiz adımları çalışıyor, hücre tipi haritası çıkıyor, etiketler büyütülüyor ve şeklin hangi kodla üretildiği kayıt altında gösteriliyor. Veriler kurgusaldır."
>
  <div class="ca-sci__win" aria-hidden="true">
    <div class="ca-sci__bar">
      <span class="ca-sci__dot"></span><span class="ca-sci__dot"></span><span class="ca-sci__dot"></span>
      <span class="ca-sci__bar-title">Hücre atlası projesi</span>
      <span class="ca-sci__sample">Kurgusal örnek veri</span>
    </div>

    <div class="ca-sci__stage">
      <!-- Chat column -->
      <div class="ca-sci__chat">
        <div class="ca-sci__user">
          <p class="ca-sci__bubble"><span data-role="prompt"></span><span class="ca-sci__caret ca-sci__caret--p"></span></p>
          <span class="ca-sci__file">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="2" y="1.5" width="12" height="13" rx="2" fill="#2a8f8a"/><circle cx="6" cy="6" r="1.2" fill="#fff"/><circle cx="10" cy="7.5" r="1.2" fill="#fff"/><circle cx="7" cy="10.5" r="1.2" fill="#fff"/></svg>
            deney3.h5ad
          </span>
        </div>

        <div class="ca-sci__respond">
          <div class="ca-sci__status">
            <span class="ca-sci__spark"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2v6M12 16v6M2 12h6M16 12h6M4.9 4.9l4.2 4.2M14.9 14.9l4.2 4.2M19.1 4.9l-4.2 4.2M9.1 14.9l-4.2 4.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
            <div>
              <p class="ca-sci__status-title">Analiz çalışıyor</p>
              <p class="ca-sci__status-sub" data-role="sub">Veri okunuyor</p>
            </div>
          </div>
          <div class="ca-sci__done">
            <p class="ca-sci__done-text"><span data-role="done"></span></p>
          </div>
        </div>
      </div>

      <!-- Right panel -->
      <div class="ca-sci__panel">
        <!-- Layer: run log -->
        <div class="ca-sci__log">
          <p class="ca-sci__panel-title">Çalışma kaydı</p>
          <div class="ca-sci__logrow"><span class="ca-sci__tick">✓</span><span><strong>Veri okundu</strong><small>4.812 hücre · 18.240 gen</small></span></div>
          <div class="ca-sci__logrow"><span class="ca-sci__tick">✓</span><span><strong>Kalite kontrolü</strong><small>157 düşük kaliteli hücre çıkarıldı</small></span></div>
          <div class="ca-sci__logrow"><span class="ca-sci__tick">✓</span><span><strong>Kümeleme</strong><small>7 küme bulundu</small></span></div>
          <div class="ca-sci__logrow"><span class="ca-sci__tick">✓</span><span><strong>Literatür karşılaştırması</strong><small>6 makale tarandı</small></span></div>
        </div>

        <!-- Layer: figure -->
        <div class="ca-sci__fig">
          <p class="ca-sci__panel-title">Hücre tipi haritası <span>(UMAP)</span></p>
          <svg class="ca-sci__svg" viewBox="0 0 300 230" preserveAspectRatio="xMidYMid meet">
