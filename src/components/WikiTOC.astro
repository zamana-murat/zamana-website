---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** Minimum number of H2 headings before the box is shown. */
  minH2?: number;
}
const { headings, minH2 = 4 } = Astro.props;

// H2 only: the page title is H1 and H3 lists get too long on 3,000+ word pages.
const items = headings.filter((h) => h.depth === 2 && h.slug && h.text.trim());
const show = items.length >= minH2;
---

{show && (
  <nav class="wiki-toc" aria-label="Bu sayfada">
    <details class="wiki-toc__details" open data-wiki-toc>
      <summary class="wiki-toc__title">
        Bu sayfada <span class="wiki-toc__count">{items.length} başlık</span>
      </summary>
      <ol class="wiki-toc__list">
        {items.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
  </nav>
)}

{show && (
  <script is:inline>
    (() => {
      // Collapsed by default on small screens; open (no-JS default) on desktop.
      if (!window.matchMedia('(max-width: 960px)').matches) return;
      document.querySelectorAll('[data-wiki-toc]').forEach((d) => d.removeAttribute('open'));
    })();
  </script>
)}

<style>
  .wiki-toc {
    margin: 0 0 2rem;
    border: 1px solid var(--c-border-gold, var(--c-border));
    border-left: 3px solid var(--c-gold);
    border-radius: var(--r-card);
    background: var(--c-bg-subtle);
    font-size: 0.92rem;
  }
  .wiki-toc__title {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-navy);
  }
  .wiki-toc__title::-webkit-details-marker { display: none; }
  .wiki-toc__title::after {
    content: '';
    margin-left: auto;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--c-gold-dark);
    border-bottom: 2px solid var(--c-gold-dark);
    transform: rotate(45deg) translateY(-2px);
    transition: transform var(--t-fast);
  }
  .wiki-toc__details[open] > .wiki-toc__title::after {
    transform: rotate(-135deg) translateY(-2px);
  }
  .wiki-toc__count {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 0.78rem;
    color: var(--c-text-muted);
  }
  .wiki-toc__list {
    margin: 0;
    padding: 0 1.1rem 0.9rem 2.4rem;
    columns: 2;
    column-gap: 2rem;
  }
  .wiki-toc__list li {
    break-inside: avoid;
    padding: 0.15rem 0;
    line-height: 1.45;
  }
  .wiki-toc__list li::marker {
    color: var(--c-gold-dark);
    font-weight: 700;
  }
  .wiki-toc__list a {
    color: var(--c-navy);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .wiki-toc__list a:hover {
    color: var(--c-gold-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 720px) {
    .wiki-toc__list { columns: 1; }
  }
</style>
