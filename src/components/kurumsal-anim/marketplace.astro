---
/**
 * Turkish, code-driven hero animation for /kurumsal/marketplace/.
 * Scenario: a fictional partner catalog. The user searches "muhasebe", opens a fictional
 * accounting connector, reviews the permissions it asks for, sends it for IT approval and
 * it is enabled for the finance team. Partner names are fictional; no real logos or brands.
 * All elements live in the markup; the script only toggles data-step and types text.
 */
---

<div
  class="ka-marketplace"
  data-step="0"
  data-query="muhasebe"
  role="img"
  aria-label="Kurgusal bir iş ortağı kataloğunda muhasebe aranıyor, bir muhasebe bağlayıcısının istediği izinler inceleniyor, BT onayına gönderiliyor ve onaylandıktan sonra finans ekibine açılıyor."
>
  <div class="ka-marketplace-win" aria-hidden="true">
    <div class="ka-marketplace-bar">
      <span class="ka-marketplace-dot"></span><span class="ka-marketplace-dot"></span><span class="ka-marketplace-dot"></span>
      <span class="ka-marketplace-bar-title">İş ortağı kataloğu</span>
      <span class="ka-marketplace-fict">Kurgusal örnek</span>
    </div>

    <div class="ka-marketplace-top">
      <div class="ka-marketplace-search">
        <svg viewBox="0 0 24 24" width="14" height="14"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span class="ka-marketplace-ph">Ara: bağlayıcı, ürün, ortak</span>
        <span data-role="q"></span><span class="ka-marketplace-caret"></span>
      </div>
      <div class="ka-marketplace-tabs">
        <span class="ka-marketplace-tab ka-marketplace-tab--on">Tümü</span>
        <span class="ka-marketplace-tab">Bağlayıcılar</span>
        <span class="ka-marketplace-tab">Ürünler</span>
        <span class="ka-marketplace-tab ka-marketplace-tab--wide">Hizmet ortakları</span>
      </div>
    </div>

    <div class="ka-marketplace-stage">
      <div class="ka-marketplace-grid">
        <div class="ka-marketplace-card ka-marketplace-card--hit">
          <span class="ka-marketplace-ic ka-marketplace-ic--a">DB</span>
          <p class="ka-marketplace-name">Defterim Bulut</p>
          <p class="ka-marketplace-kind">Bağlayıcı · Muhasebe</p>
          <span class="ka-marketplace-added">Eklendi</span>
        </div>
        <div class="ka-marketplace-card">
          <span class="ka-marketplace-ic ka-marketplace-ic--b">YL</span>
          <p class="ka-marketplace-name">Yolda Lojistik</p>
          <p class="ka-marketplace-kind">Bağlayıcı · Sevkiyat</p>
        </div>
        <div class="ka-marketplace-card">
          <span class="ka-marketplace-ic ka-marketplace-ic--c">MA</span>
          <p class="ka-marketplace-name">Mütalaa Asistanı</p>
          <p class="ka-marketplace-kind">Ürün · Hukuk</p>
          <span class="ka-marketplace-commit">Taahhüde sayılabilir</span>
        </div>
        <div class="ka-marketplace-card ka-marketplace-card--hit">
          <span class="ka-marketplace-ic ka-marketplace-ic--d">AF</span>
          <p class="ka-marketplace-name">Akçe Finans Ajanı</p>
          <p class="ka-marketplace-kind">Ürün · Muhasebe ve finans</p>
          <span class="ka-marketplace-commit">Taahhüde sayılabilir</span>
        </div>
        <div class="ka-marketplace-card ka-marketplace-card--x">
          <span class="ka-marketplace-ic ka-marketplace-ic--e">KV</span>
          <p class="ka-marketplace-name">Kule Veri</p>
          <p class="ka-marketplace-kind">Ürün · Veri ambarı</p>
          <span class="ka-marketplace-commit">Taahhüde sayılabilir</span>
        </div>
        <div class="ka-marketplace-card ka-marketplace-card--x">
          <span class="ka-marketplace-ic ka-marketplace-ic--f">KD</span>
          <p class="ka-marketplace-name">Köprü Danışmanlık</p>
          <p class="ka-marketplace-kind">Hizmet ortağı · Kurulum</p>
        </div>
      </div>

      <!-- Detail panel for the selected connector -->
      <div class="ka-marketplace-panel">
        <div class="ka-marketplace-ph-head">
          <span class="ka-marketplace-ic ka-marketplace-ic--a">DB</span>
          <div>
            <p class="ka-marketplace-name">Defterim Bulut</p>
            <p class="ka-marketplace-kind">Muhasebe bağlayıcısı</p>
          </div>
        </div>
        <p class="ka-marketplace-sub">İstediği izinler</p>
        <ul class="ka-marketplace-perms">
          <li style="--i:0"><span class="ka-marketplace-ok">✓</span>Faturaları okuma</li>
          <li style="--i:1"><span class="ka-marketplace-ok">✓</span>Cari hesap listesi</li>
          <li style="--i:2"><span class="ka-marketplace-no">✕</span>Kayıt yazma yok</li>
        </ul>
        <p class="ka-marketplace-data">Veri işleyen: iş ortağı, KVKK kontrolü gerekli</p>
        <div class="ka-marketplace-act">
          <span class="ka-marketplace-btn">BT onayına gönder</span>
          <span class="ka-marketplace-status ka-marketplace-status--wait"><span class="ka-marketplace-spin"></span>BT onayı bekleniyor</span>
          <span class="ka-marketplace-status ka-marketplace-status--done"><span class="ka-marketplace-tick">✓</span>Onaylandı · Finans ekibine açıldı</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ka-marketplace {
    --kam-ink: var(--c-navy);
    --kam-muted: var(--c-text-muted);
    --kam-line: var(--c-border);
    --kam-soft: #f3f1ea;
    width: 100%;
    aspect-ratio: 16 / 11;
    min-height: 320px;
    max-height: 520px;
    font-size: clamp(12px, 1.2vw, 15px);
    container-type: inline-size;
  }
  .ka-marketplace p { margin: 0; }
  .ka-marketplace-win { height: 100%; display: flex; flex-direction: column; background: var(--c-white, #fff); transition: opacity .5s; }
  .ka-marketplace-bar { display: flex; align-items: center; gap: 6px; padding: 0.7em 1em; border-bottom: 1px solid var(--kam-line); }
  .ka-marketplace-dot { width: 9px; height: 9px; border-radius: 50%; background: #e2ded3; }
  .ka-marketplace-bar-title { margin-left: 0.6em; font-size: 0.8em; color: var(--kam-muted); font-weight: 700; }
  .ka-marketplace-fict { margin-left: auto; font-size: 0.66em; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--c-gold-text); background: #f7efd9; border-radius: 4px; padding: 0.25em 0.55em; }

  .ka-marketplace-top { padding: 0.8em 1.1em 0.5em; display: flex; flex-direction: column; gap: 0.6em; }
  .ka-marketplace-search {
    display: flex; align-items: center; gap: 0.5em; border: 1px solid rgba(15, 40, 85, .22); border-radius: 9px;
    padding: 0.5em 0.8em; color: var(--kam-ink); min-height: 1.4em; line-height: 1.4;
  }
  .ka-marketplace-search svg { color: var(--kam-muted); flex-shrink: 0; }
  .ka-marketplace-ph { color: var(--kam-muted); opacity: .85; }
  .ka-marketplace[data-step="1"] .ka-marketplace-ph,
  .ka-marketplace[data-step="2"] .ka-marketplace-ph,
  .ka-marketplace[data-step="3"] .ka-marketplace-ph,
  .ka-marketplace[data-step="4"] .ka-marketplace-ph,
  .ka-marketplace[data-step="5"] .ka-marketplace-ph,
  .ka-marketplace[data-step="6"] .ka-marketplace-ph { display: none; }
  .ka-marketplace [data-role="q"] { font-weight: 700; }
  .ka-marketplace-caret { display: none; width: 2px; height: 1em; margin-left: -0.35em; background: var(--kam-ink); animation: ka-marketplace-blink 1s steps(1) infinite; }
  .ka-marketplace[data-typing] .ka-marketplace-caret { display: inline-block; }

  .ka-marketplace-tabs { display: flex; gap: 0.4em; flex-wrap: nowrap; overflow: hidden; }
  .ka-marketplace-tab { font-size: 0.78em; font-weight: 700; color: var(--kam-muted); border: 1px solid var(--kam-line); border-radius: 999px; padding: 0.3em 0.8em; white-space: nowrap; }
  .ka-marketplace-tab--on { background: var(--c-navy); color: #fff; border-color: var(--c-navy); }

  .ka-marketplace-stage { position: relative; flex: 1; min-height: 0; padding: 0.3em 1.1em 1em; }
  .ka-marketplace-grid { height: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 0.65em; }
  .ka-marketplace-card {
    position: relative; border: 1px solid var(--kam-line); border-radius: 10px; padding: 0.6em 0.8em; overflow: hidden;
    display: flex; flex-direction: column; gap: 0.12em; background: #fff; min-width: 0;
    transition: opacity .35s, transform .35s, border-color .35s, box-shadow .35s;
  }
  .ka-marketplace-ic {
    width: 2.2em; height: 2.2em; border-radius: 8px; display: grid; place-items: center;
    font-weight: 800; font-size: 0.78em; margin-bottom: 0.2em; flex-shrink: 0;
  }
  .ka-marketplace-ic--a { background: var(--c-navy); color: var(--c-gold); }
  .ka-marketplace-ic--b { background: #e5eef7; color: #1a3d7a; }
  .ka-marketplace-ic--c { background: #f4ead0; color: var(--c-gold-text); }
  .ka-marketplace-ic--d { background: #e3f0e8; color: #2f6b47; }
  .ka-marketplace-ic--e { background: #ece7f5; color: #5b3fa0; }
  .ka-marketplace-ic--f { background: #f3e6e1; color: #8a4a33; }
  .ka-marketplace-card > * { flex-shrink: 0; }
  .ka-marketplace-name { font-weight: 800; color: var(--kam-ink); line-height: 1.4; font-size: 0.92em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ka-marketplace-kind { font-size: 0.74em; color: var(--kam-muted); line-height: 1.3; }
  .ka-marketplace-commit {
    margin-top: auto; align-self: flex-start; font-size: 0.66em; font-weight: 700; color: var(--c-gold-text);
    background: #f7efd9; border-radius: 4px; padding: 0.2em 0.5em; white-space: nowrap;
  }
  .ka-marketplace-added {
    position: absolute; top: 0.7em; right: 0.7em; font-size: 0.66em; font-weight: 800; color: #fff;
    background: #2f7a4f; border-radius: 999px; padding: 0.2em 0.6em; opacity: 0; transform: scale(.8);
    transition: opacity .35s, transform .35s;
  }

  /* step 1+: filter */
  .ka-marketplace[data-step="2"] .ka-marketplace-card:not(.ka-marketplace-card--hit),
  .ka-marketplace[data-step="3"] .ka-marketplace-card:not(.ka-marketplace-card--hit),
  .ka-marketplace[data-step="4"] .ka-marketplace-card:not(.ka-marketplace-card--hit),
  .ka-marketplace[data-step="5"] .ka-marketplace-card:not(.ka-marketplace-card--hit),
  .ka-marketplace[data-step="6"] .ka-marketplace-card:not(.ka-marketplace-card--hit) { opacity: .28; transform: scale(.97); }
  .ka-marketplace[data-step="2"] .ka-marketplace-card--hit { border-color: var(--c-gold); }
  .ka-marketplace[data-step="2"] .ka-marketplace-card--hit:first-child { box-shadow: 0 0 0 3px rgba(201, 168, 76, .35); }
  .ka-marketplace[data-step="6"] .ka-marketplace-card--hit:first-child { border-color: #2f7a4f; }
  .ka-marketplace[data-step="6"] .ka-marketplace-added { opacity: 1; transform: none; }

  /* detail panel */
  .ka-marketplace-panel {
    position: absolute; top: 0.3em; right: 1.1em; bottom: 1em; width: 56%;
    background: #fff; border: 1px solid rgba(15, 40, 85, .16); border-radius: 12px;
    box-shadow: 0 12px 30px rgba(15, 40, 85, .16); padding: 0.9em 1em;
    display: flex; flex-direction: column; gap: 0.45em;
    opacity: 0; transform: translateX(16px); pointer-events: none; transition: opacity .4s, transform .4s;
  }
  .ka-marketplace[data-step="3"] .ka-marketplace-panel,
  .ka-marketplace[data-step="4"] .ka-marketplace-panel,
  .ka-marketplace[data-step="5"] .ka-marketplace-panel { opacity: 1; transform: none; }
  .ka-marketplace-ph-head { display: flex; gap: 0.6em; align-items: center; }
  .ka-marketplace-ph-head .ka-marketplace-ic { margin: 0; }
  .ka-marketplace-sub { font-size: 0.68em; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--kam-muted); margin-top: 0.2em !important; }
  .ka-marketplace-perms { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3em; font-size: 0.86em; color: var(--kam-ink); }
  .ka-marketplace-perms li {
    display: flex; align-items: center; gap: 0.5em; opacity: 0; transform: translateX(-6px);
    transition: opacity .3s calc(var(--i) * 260ms + 250ms), transform .3s calc(var(--i) * 260ms + 250ms);
  }
  .ka-marketplace[data-step="3"] .ka-marketplace-perms li,
  .ka-marketplace[data-step="4"] .ka-marketplace-perms li,
  .ka-marketplace[data-step="5"] .ka-marketplace-perms li { opacity: 1; transform: none; }
  .ka-marketplace-ok, .ka-marketplace-no { width: 1.4em; height: 1.4em; border-radius: 50%; display: grid; place-items: center; font-size: 0.75em; font-weight: 800; flex-shrink: 0; }
  .ka-marketplace-ok { background: #e3f0e8; color: #2f6b47; }
  .ka-marketplace-no { background: #f3e6e1; color: #8a4a33; }
  .ka-marketplace-data { font-size: 0.74em; color: var(--c-gold-text); background: #fbf6e8; border-radius: 6px; padding: 0.4em 0.6em; line-height: 1.35; }
  .ka-marketplace-act { margin-top: auto; position: relative; min-height: 2.3em; }
  .ka-marketplace-btn, .ka-marketplace-status {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 0.45em;
    border-radius: 8px; font-size: 0.82em; font-weight: 800; transition: opacity .3s, transform .2s;
  }
  .ka-marketplace-btn { background: var(--c-navy); color: #fff; }
  .ka-marketplace[data-press] .ka-marketplace-btn { transform: scale(.95); background: var(--c-navy-mid, #1a3d7a); }
  .ka-marketplace-status { opacity: 0; }
  .ka-marketplace-status--wait { background: var(--kam-soft); color: var(--kam-ink); }
  .ka-marketplace-status--done { background: #e3f0e8; color: #2f6b47; }
  .ka-marketplace[data-step="4"] .ka-marketplace-btn,
  .ka-marketplace[data-step="5"] .ka-marketplace-btn { opacity: 0; }
  .ka-marketplace[data-step="4"] .ka-marketplace-status--wait { opacity: 1; }
  .ka-marketplace[data-step="5"] .ka-marketplace-status--done { opacity: 1; }
  .ka-marketplace-spin { width: 0.9em; height: 0.9em; border-radius: 50%; border: 2px solid rgba(15, 40, 85, .2); border-top-color: var(--c-gold); animation: ka-marketplace-spin 0.9s linear infinite; }
  .ka-marketplace-tick { width: 1.3em; height: 1.3em; border-radius: 50%; background: #2f7a4f; color: #fff; display: grid; place-items: center; font-size: 0.8em; }

  .ka-marketplace[data-step="7"] .ka-marketplace-win { opacity: 0; }

  /* narrow: 2 columns, 4 cards, panel full width */
  @container (max-width: 470px) {
    .ka-marketplace-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ka-marketplace-card--x { display: none; }
    .ka-marketplace-tab--wide { display: none; }
    .ka-marketplace-panel { left: 1.1em; width: auto; }
    .ka-marketplace-fict { font-size: 0.6em; }
    .ka-marketplace-commit { font-size: 0.6em; }
  }

  @keyframes ka-marketplace-blink { 50% { opacity: 0; } }
  @keyframes ka-marketplace-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .ka-marketplace *, .ka-marketplace *::before { animation: none !important; transition: none !important; }
  }
</style>

<script>
  function setupMarketplace(root: HTMLElement) {
    const query = root.dataset.query || '';
    const q = root.querySelector<HTMLElement>('[data-role="q"]')!;
    let timers: number[] = [];
    let running = false;
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const step = (n: number) => { root.dataset.step = String(n); };

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      q.textContent = '';
      delete root.dataset.typing; delete root.dataset.press; step(0);
    };

    const cycle = () => {
      reset();
      // 1: type the search query
      at(1000, () => { step(1); root.dataset.typing = '1'; });
      for (let i = 0; i <= query.length; i++) at(1100 + i * 110, () => { q.textContent = query.slice(0, i); });
      const t1 = 1100 + query.length * 110;
      // 2: results filtered, the connector highlighted
      at(t1 + 400, () => { delete root.dataset.typing; step(2); });
      // 3: detail panel with permissions
      at(t1 + 2000, () => step(3));
      // press "send for IT approval"
      at(t1 + 5600, () => { root.dataset.press = '1'; });
      at(t1 + 5900, () => { delete root.dataset.press; step(4); });
      // 5: approved
      at(t1 + 7900, () => step(5));
      // 6: panel closes, card shows "Eklendi"
      at(t1 + 10000, () => step(6));
      at(t1 + 13000, () => step(7));
      at(t1 + 13600, () => { if (running) cycle(); });
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      q.textContent = query;
      step(3);
      return;
    }

    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !running) { running = true; cycle(); }
      else if (!visible && running) { running = false; reset(); }
    }, { threshold: 0.25 });
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('.ka-marketplace').forEach(setupMarketplace);
</script>
