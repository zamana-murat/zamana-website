---
import { claudeNavColumns, claudeNavFooter } from '../data/claude-nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return path === '/';
  return path === h || path.startsWith(h + '/');
};
const links = [
  { href: '/programlar/', label: 'Eğitim' },
  { href: '/wiki/', label: 'Wiki' },
  { href: '/haberler/', label: 'Haberler' },
  { href: '/sss/', label: 'SSS' },
  { href: '/hakkinda/', label: 'Hakkında' },
  { href: '/iletisim/', label: 'İletişim' },
];
const claudeActive = isActive('/claude/');
const itemActive = (href: string) => !href.includes('#') && (href.replace(/\/$/, '') || '/') === path;
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Zamana ana sayfa">
      <img src="/images/zamana-logo-horizontal-400.webp" srcset="/images/zamana-logo-horizontal-400.webp 400w, /images/zamana-logo-horizontal-600.webp 600w" sizes="184px" alt="Zamana" width="184" height="61" class="brand__mark" />
    </a>

    <nav class="nav-desktop" aria-label="Ana menü">
      <div class="mega" id="claude-mega-root">
        <button
          type="button"
          class={`nav-link mega__trigger${claudeActive ? ' nav-link--active' : ''}`}
          id="claude-mega-trigger"
          aria-expanded="false"
          aria-controls="claude-mega"
        >
          Claude
          <svg class="mega__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="mega__panel" id="claude-mega" role="region" aria-labelledby="claude-mega-trigger">
          <div class="container">
            <div class="mega__cols">
              {claudeNavColumns.map((col) => (
                <div class={`mega__col${col.arrow ? ' mega__col--arrow' : ''}`}>
                  {col.groups.map((g) => (
                    <div class="mega__group">
                      <p class="mega__heading">{g.title}</p>
                      <ul>
                        {g.items.map((it) => (
                          <li>
                            <a href={it.href} class="mega__item" aria-current={itemActive(it.href) ? 'page' : undefined}>
                              <span class="mega__label">
                                {it.label}
                                {col.arrow && (
                                  <svg class="mega__arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                )}
                              </span>
                              <span class="mega__desc">{it.desc}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ))}
            </div>

            <div class="mega__strip">
              <a href={claudeNavFooter.migrate.href} class="mega__migrate">
                {claudeNavFooter.migrate.label}
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <div class="mega__btns">
                {claudeNavFooter.buttons.map((b) => (
                  <a href={b.href} class="mega__btn" target="_blank" rel="noopener">
                    {b.label}
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M6 3h7v7M13 3 6 10M11 13H3V5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="visually-hidden">(yeni sekmede açılır)</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      {links.map(l => (
        <a
          href={l.href}
          class={`nav-link${isActive(l.href) ? ' nav-link--active' : ''}`}
        >{l.label}</a>
      ))}
      <a href="/iletisim/" class="btn btn--primary nav-cta">Görüşme Al</a>
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-label="Menüyü aç" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Mobil menü">
    <div class="macc">
      <button
        type="button"
        class={`nav-link macc__trigger${claudeActive ? ' nav-link--active' : ''}`}
        id="claude-macc-trigger"
        aria-expanded="false"
        aria-controls="claude-macc"
      >
        Claude
        <svg class="mega__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="macc__panel" id="claude-macc" hidden>
        {claudeNavColumns.flatMap((c) => c.groups).map((g) => (
          <div class="macc__group">
            <p class="mega__heading">{g.title}</p>
            <ul>
              {g.items.map((it) => (
                <li><a href={it.href} aria-current={itemActive(it.href) ? 'page' : undefined}>{it.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="macc__group macc__strip">
          <a href={claudeNavFooter.migrate.href}>{claudeNavFooter.migrate.label}</a>
          {claudeNavFooter.buttons.map((b) => (
            <a href={b.href} target="_blank" rel="noopener">{b.label} <span aria-hidden="true">&#8599;</span><span class="visually-hidden">(yeni sekmede açılır)</span></a>
          ))}
        </div>
      </div>
    </div>
    {links.map(l => (
      <a href={l.href} class={`nav-link${isActive(l.href) ? ' nav-link--active' : ''}`}>{l.label}</a>
    ))}
    <a href="/iletisim/" class="btn btn--primary">Görüşme Al</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-white);
    border-bottom: 1px solid var(--c-border);
    box-shadow: 0 1px 4px rgba(15, 40, 85, 0.04);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: var(--s-4);
    /* Keep .container side gutters (shorthand used to reset them to 0). */
    padding: 0.3rem var(--s-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand__mark {
    height: 61px;
    width: auto;
    object-fit: contain;
  }
  @media (max-width: 600px) {
    .brand__mark { height: 48px; }
    .site-header__inner { min-height: 64px; }
  }
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .nav-link {
    font-weight: 500;
    color: var(--c-text);
    padding: 0.4rem 0.2rem;
    position: relative;
    transition: color var(--t-fast);
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--c-gold-text); }
  .nav-link--active { color: var(--c-gold-text); }
  .nav-link--active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    height: 2px;
    background: var(--c-gold);
    border-radius: 2px;
  }
  .nav-link:focus-visible,
  .nav-toggle:focus-visible {
    outline: 2px solid var(--c-gold);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .nav-cta {
    margin-left: var(--s-2);
    padding: 0.55rem 1.1rem;
    font-size: 0.92rem;
  }

  /* ── Claude mega menu (desktop) ─────────────────────── */
  .mega__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .mega__chev { transition: transform var(--t-fast); }
  .mega__trigger[aria-expanded="true"] { color: var(--c-gold-text); }
  .mega__trigger[aria-expanded="true"] .mega__chev,
  .macc__trigger[aria-expanded="true"] .mega__chev { transform: rotate(180deg); }

  /* Positioned against .site-header (sticky = containing block). */
  .mega__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0 var(--s-4);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--t-fast), transform var(--t-fast), visibility 0s linear 150ms;
    pointer-events: none;
  }
  .mega.is-open .mega__panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--t-fast), transform var(--t-fast), visibility 0s;
    pointer-events: auto;
  }
  .mega__panel > .container {
    max-width: calc(var(--max-w) - 2 * var(--s-4));
    margin-top: 6px;
    padding: var(--s-5) var(--s-5) 0;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    box-shadow: 0 16px 40px rgba(15, 40, 85, 0.14), 0 2px 6px rgba(15, 40, 85, 0.06);
  }
  /* Invisible bridge so the pointer can travel from trigger to panel. */
  .mega__panel::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: -10px;
    height: 16px;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .mega__group + .mega__group { margin-top: var(--s-4); }
  .mega__heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0 0 var(--s-2);
    padding-left: 0.6rem;
  }
  .mega ul { list-style: none; margin: 0; padding: 0; }
  .mega__item {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--r-input);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition: background var(--t-fast), border-color var(--t-fast);
  }
  .mega__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--c-navy);
    transition: color var(--t-fast);
  }
  .mega__desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--c-text-muted);
  }
  .mega__arrow { flex-shrink: 0; color: var(--c-text-muted); transition: transform var(--t-fast), color var(--t-fast); }
  .mega__item:hover,
  .mega__item:focus-visible,
  .mega__item[aria-current="page"] {
    background: var(--c-cream);
    border-left-color: var(--c-gold);
  }
  .mega__item:hover .mega__label,
  .mega__item:focus-visible .mega__label { color: var(--c-gold-text); }
  .mega__item:hover .mega__arrow,
  .mega__item:focus-visible .mega__arrow { color: var(--c-gold-text); transform: translateX(2px); }
  .mega__item:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 1px; }

  .mega__strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-4);
    padding: var(--s-3) 0.6rem var(--s-4);
    border-top: 1px solid var(--c-border);
  }
  .mega__migrate {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--c-navy);
    text-decoration: none;
  }
  .mega__migrate:hover { color: var(--c-gold-text); }
  .mega__btns { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .mega__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--c-navy);
    border: 1.5px solid var(--c-border);
    border-radius: var(--r-btn);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--t-fast), color var(--t-fast), background var(--t-fast);
  }
  .mega__btn:hover { border-color: var(--c-gold); color: var(--c-gold-text); background: var(--c-cream); }
  .mega__migrate:focus-visible,
  .mega__btn:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; border-radius: var(--r-input); }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 32px;
    padding: 4px;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--c-navy);
    border-radius: 2px;
    transition: transform var(--t-fast), opacity var(--t-fast);
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
    border-top: 1px solid var(--c-border);
    background: var(--c-white);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
  }
  .nav-mobile.is-open { display: flex; }

  /* ── Claude accordion (mobile) ──────────────────────── */
  .macc__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    width: fit-content;
  }
  .macc__panel {
    margin-top: var(--s-2);
    padding: var(--s-2) 0 var(--s-2) var(--s-3);
    border-left: 2px solid var(--c-border-gold);
  }
  .macc__group + .macc__group { margin-top: var(--s-3); }
  .macc__group .mega__heading { padding-left: 0; }
  .macc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .macc a {
    color: var(--c-navy);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .macc a:hover,
  .macc a[aria-current="page"] { color: var(--c-gold-text); }
  .macc a:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; border-radius: 4px; }
  .macc__strip {
    display: grid;
    gap: 0.35rem;
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-border);
  }

  @media (max-width: 1180px) {
    .nav-desktop { gap: var(--s-3); }
    .nav-link { font-size: 0.95rem; }
    .nav-cta { margin-left: 0; padding: 0.5rem 0.95rem; }
  }
  @media (max-width: 1040px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mega__panel, .mega__chev, .mega__arrow { transition: none !important; }
  }
</style>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
  });

  // Mobile "Claude" accordion
  const maccTrigger = document.getElementById('claude-macc-trigger');
  const maccPanel = document.getElementById('claude-macc');
  maccTrigger?.addEventListener('click', () => {
    const open = maccTrigger.getAttribute('aria-expanded') !== 'true';
    maccTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (maccPanel) maccPanel.hidden = !open;
  });

  // Desktop "Claude" mega menu: click toggles, hover opens with small delays.
  const root = document.getElementById('claude-mega-root');
  const trigger = document.getElementById('claude-mega-trigger');
  const panel = document.getElementById('claude-mega');
  if (root && trigger && panel) {
    let openTimer: number | undefined;
    let closeTimer: number | undefined;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const isOpen = () => root.classList.contains('is-open');
    const setOpen = (open: boolean) => {
      window.clearTimeout(openTimer);
      window.clearTimeout(closeTimer);
      root.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    trigger.addEventListener('click', () => setOpen(!isOpen()));

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !canHover.matches) return;
      window.clearTimeout(closeTimer);
      if (!isOpen()) openTimer = window.setTimeout(() => setOpen(true), 90);
    });
    root.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !canHover.matches) return;
      window.clearTimeout(openTimer);
      closeTimer = window.setTimeout(() => setOpen(false), 220);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        trigger.focus();
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) setOpen(false);
    });
    root.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (isOpen() && next && !root.contains(next)) setOpen(false);
    });
  }
</script>
