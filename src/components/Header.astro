---
import { claudeNavColumns, claudeNavFooter } from '../data/claude-nav';
import { kurumsalNavColumns, kurumsalNavFooter } from '../data/kurumsal-nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return path === '/';
  return path === h || path.startsWith(h + '/');
};
const links = [
  { href: '/programlar/', label: 'Eğitim' },
  { href: '/wiki/', label: 'Wiki' },
  { href: '/haberler/', label: 'Haberler' },
  { href: '/sss/', label: 'SSS' },
  { href: '/hakkinda/', label: 'Hakkında' },
  { href: '/iletisim/', label: 'İletişim' },
];
// Mega menus, in menu order. Each renders a desktop panel and a mobile accordion.
const megas = [
  { id: 'claude', label: 'Claude', base: '/claude/', columns: claudeNavColumns, footer: claudeNavFooter },
  { id: 'kurumsal', label: 'Kurumsal', base: '/kurumsal/', columns: kurumsalNavColumns, footer: kurumsalNavFooter },
];
const itemActive = (href: string) => !href.includes('#') && (href.replace(/\/$/, '') || '/') === path;
const chevron = '<path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Zamana ana sayfa">
      <img src="/images/zamana-logo-horizontal-400.webp" srcset="/images/zamana-logo-horizontal-400.webp 400w, /images/zamana-logo-horizontal-600.webp 600w" sizes="184px" alt="Zamana" width="184" height="61" class="brand__mark" />
    </a>

    <nav class="nav-desktop" aria-label="Ana menü">
      {megas.map((m) => (
        <div class="mega" data-mega>
          <button
            type="button"
            class={`nav-link mega__trigger${isActive(m.base) ? ' nav-link--active' : ''}`}
            id={`${m.id}-mega-trigger`}
            aria-expanded="false"
            aria-controls={`${m.id}-mega`}
            data-mega-trigger
          >
            {m.label}
            <svg class="mega__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false" set:html={chevron} />
          </button>

          <div class="mega__panel" id={`${m.id}-mega`} role="region" aria-labelledby={`${m.id}-mega-trigger`}>
            <div class="container">
              <div class="mega__cols" style={`--mega-cols: ${m.columns.length}`}>
                {m.columns.map((col) => (
                  <div class={`mega__col${col.arrow ? ' mega__col--arrow' : ''}`}>
                    {col.groups.map((g) => (
                      <div class="mega__group">
                        <p class="mega__heading">{g.title}</p>
                        <ul>
                          {g.items.map((it) => (
                            <li>
                              <a href={it.href} class="mega__item" aria-current={itemActive(it.href) ? 'page' : undefined}>
                                <span class="mega__label">
                                  {it.label}
                                  {col.arrow && (
                                    <svg class="mega__arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                  )}
                                </span>
                                <span class="mega__desc">{it.desc}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ))}
              </div>

              <div class="mega__strip">
                <a href={m.footer.link.href} class="mega__migrate">
                  {m.footer.link.label}
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <div class="mega__btns">
                  {m.footer.buttons.map((b) => (
                    b.external ? (
                      <a href={b.href} class="mega__btn" target="_blank" rel="noopener">
                        {b.label}
                        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M6 3h7v7M13 3 6 10M11 13H3V5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="visually-hidden">(yeni sekmede açılır)</span>
                      </a>
                    ) : (
                      <a href={b.href} class="mega__btn" aria-current={itemActive(b.href) ? 'page' : undefined}>
                        {b.icon === 'server' && (
                          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="2.5" y="2" width="11" height="5" rx="1.2"/><rect x="2.5" y="9" width="11" height="5" rx="1.2"/></g><g fill="currentColor"><circle cx="5" cy="4.5" r=".9"/><circle cx="5" cy="11.5" r=".9"/></g><path d="M8.5 4.5h2.5M8.5 11.5h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                        )}
                        {b.label}
                      </a>
                    )
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}

      {links.map(l => (
        <a
          href={l.href}
          class={`nav-link${isActive(l.href) ? ' nav-link--active' : ''}`}
        >{l.label}</a>
      ))}
    </nav>

    <!-- Live Claude status (all pages). Color and note are filled by the script below from /api/claude-status?lite=1. -->
    <div class="status-cta" data-status-cta data-level="loading">
      <a href="/claude-status/" class="status-cta__btn" aria-describedby="status-cta-note" title="Claude altyapı durumu: kontrol ediliyor">
        <span class="status-cta__dot" aria-hidden="true"></span>
        <svg class="status-cta__icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="2.5" y="2" width="11" height="5" rx="1.2"/><rect x="2.5" y="9" width="11" height="5" rx="1.2"/></g><g fill="currentColor"><circle cx="5" cy="4.5" r=".9"/><circle cx="5" cy="11.5" r=".9"/></g><path d="M8.5 4.5h2.5M8.5 11.5h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <span class="status-cta__label">Altyapı durumu</span>
        <span class="status-cta__label-short" aria-hidden="true">Durum</span>
      </a>
      <div class="status-cta__note" id="status-cta-note" role="status" aria-live="polite" hidden>
        <button type="button" class="status-cta__close" aria-label="Bilgiyi kapat" data-status-close>&times;</button>
        <p class="status-cta__title" data-status-title></p>
        <p class="status-cta__text" data-status-text></p>
        <a href="/claude-status/" class="status-cta__more">Ayrıntılar ve güncellemeler &rarr;</a>
      </div>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-label="Menüyü aç" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Mobil menü">
    {megas.map((m) => (
      <div class="macc">
        <button
          type="button"
          class={`nav-link macc__trigger${isActive(m.base) ? ' nav-link--active' : ''}`}
          aria-expanded="false"
          aria-controls={`${m.id}-macc`}
          data-macc-trigger
        >
          {m.label}
          <svg class="mega__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false" set:html={chevron} />
        </button>
        <div class="macc__panel" id={`${m.id}-macc`} hidden>
          {m.columns.flatMap((c) => c.groups).map((g) => (
            <div class="macc__group">
              <p class="mega__heading">{g.title}</p>
              <ul>
                {g.items.map((it) => (
                  <li><a href={it.href} aria-current={itemActive(it.href) ? 'page' : undefined}>{it.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="macc__group macc__strip">
            <a href={m.footer.link.href}>{m.footer.link.label}</a>
            {m.footer.buttons.map((b) => (
              b.external
                ? <a href={b.href} target="_blank" rel="noopener">{b.label} <span aria-hidden="true">&#8599;</span><span class="visually-hidden">(yeni sekmede açılır)</span></a>
                : <a href={b.href} aria-current={itemActive(b.href) ? 'page' : undefined}>{b.icon === 'server' && <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false" style="vertical-align:-2px;margin-right:.35rem"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="2.5" y="2" width="11" height="5" rx="1.2"/><rect x="2.5" y="9" width="11" height="5" rx="1.2"/></g><g fill="currentColor"><circle cx="5" cy="4.5" r=".9"/><circle cx="5" cy="11.5" r=".9"/></g><path d="M8.5 4.5h2.5M8.5 11.5h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>}{b.label}</a>
            ))}
          </div>
        </div>
      </div>
    ))}
    {links.map(l => (
      <a href={l.href} class={`nav-link${isActive(l.href) ? ' nav-link--active' : ''}`}>{l.label}</a>
    ))}
    <a href="/iletisim/" class="btn btn--primary">Görüşme Al</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-white);
    border-bottom: 1px solid var(--c-border);
    box-shadow: 0 1px 4px rgba(15, 40, 85, 0.04);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: var(--s-4);
    /* Keep .container side gutters (shorthand used to reset them to 0). */
    padding: 0.3rem var(--s-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand__mark {
    height: 61px;
    width: auto;
    object-fit: contain;
  }
  @media (max-width: 600px) {
    .brand__mark { height: 48px; }
    .site-header__inner { min-height: 64px; }
  }
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .nav-link {
    font-weight: 500;
    color: var(--c-text);
    padding: 0.4rem 0.2rem;
    position: relative;
    transition: color var(--t-fast);
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--c-gold-text); }
  .nav-link--active { color: var(--c-gold-text); }
  .nav-link--active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    height: 2px;
    background: var(--c-gold);
    border-radius: 2px;
  }
  .nav-link:focus-visible,
  .nav-toggle:focus-visible {
    outline: 2px solid var(--c-gold);
    outline-offset: 3px;
    border-radius: 4px;
  }
  /* ── Live Claude status button (replaces the old CTA) ── */
  .nav-desktop { margin-left: auto; }
  .status-cta {
    --st: #9aa5b8; --st-bg: #eef1f5; --st-tx: #3d4a60; --st-bd: #d9dee7;
    position: relative;
    flex-shrink: 0;
  }
  .status-cta[data-level="operational"] { --st: #2e9e4f; --st-bg: #e6f5ea; --st-tx: #14592b; --st-bd: #b9e2c5; }
  .status-cta[data-level="maintenance"] { --st: #2f6fde; --st-bg: #e3ecfd; --st-tx: #1d4c9a; --st-bd: #b8cdf6; }
  .status-cta[data-level="degraded"]    { --st: #d4a514; --st-bg: #fff6d6; --st-tx: #6b5300; --st-bd: #f0d982; }
  .status-cta[data-level="partial"]     { --st: #e8730c; --st-bg: #ffead8; --st-tx: #8a3c00; --st-bd: #f6c79c; }
  .status-cta[data-level="major"]       { --st: #d83131; --st-bg: #fde3e2; --st-tx: #9b1c1c; --st-bd: #f4b0ae; }
  .status-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--st-bd);
    border-radius: 999px;
    background: var(--st-bg);
    color: var(--st-tx);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s, box-shadow 0.2s;
  }
  .status-cta__btn:hover { box-shadow: 0 2px 8px rgba(15, 40, 85, 0.12); }
  .status-cta__btn:focus-visible { outline: 2px solid var(--st); outline-offset: 3px; }
  .status-cta__dot {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--st);
    flex-shrink: 0;
  }
  .status-cta:is([data-level="degraded"], [data-level="partial"], [data-level="major"]) .status-cta__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--st);
    animation: status-cta-pulse 1.6s ease-out infinite;
  }
  @keyframes status-cta-pulse {
    from { transform: scale(0.5); opacity: 0.9; }
    to { transform: scale(1.4); opacity: 0; }
  }
  .status-cta__icon { flex-shrink: 0; }
  .status-cta__label-short { display: none; }
  .status-cta__note {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(330px, calc(100vw - 32px));
    padding: 0.8rem 2.2rem 0.8rem 0.95rem;
    background: var(--st-bg);
    color: var(--st-tx);
    border: 1px solid var(--st-bd);
    border-left: 4px solid var(--st);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(15, 40, 85, 0.14);
    font-size: 0.86rem;
    line-height: 1.45;
    z-index: 60;
  }
  .status-cta__note[hidden] { display: none; }
  .status-cta__note::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 26px;
    width: 10px;
    height: 10px;
    background: var(--st-bg);
    border-top: 1px solid var(--st-bd);
    border-left: 1px solid var(--st-bd);
    transform: rotate(45deg);
  }
  .status-cta__title { margin: 0 0 0.25rem; font-weight: 700; }
  .status-cta__text { margin: 0 0 0.45rem; }
  .status-cta__text:empty { display: none; }
  .status-cta__more { color: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .status-cta__close {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .status-cta__close:hover { background: rgba(0, 0, 0, 0.06); }
  .status-cta__close:focus-visible { outline: 2px solid var(--st); outline-offset: 1px; }

  /* ── Mega menus (desktop) ───────────────────────── */
  .mega__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .mega__chev { transition: transform var(--t-fast); }
  .mega__trigger[aria-expanded="true"] { color: var(--c-gold-text); }
  .mega__trigger[aria-expanded="true"] .mega__chev,
  .macc__trigger[aria-expanded="true"] .mega__chev { transform: rotate(180deg); }

  /* Positioned against .site-header (sticky = containing block). */
  .mega__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0 var(--s-4);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--t-fast), transform var(--t-fast), visibility 0s linear 150ms;
    pointer-events: none;
  }
  .mega.is-open .mega__panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--t-fast), transform var(--t-fast), visibility 0s;
    pointer-events: auto;
  }
  .mega__panel > .container {
    max-width: calc(var(--max-w) - 2 * var(--s-4));
    margin-top: 6px;
    padding: var(--s-5) var(--s-5) 0;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    box-shadow: 0 16px 40px rgba(15, 40, 85, 0.14), 0 2px 6px rgba(15, 40, 85, 0.06);
  }
  /* Invisible bridge so the pointer can travel from trigger to panel. */
  .mega__panel::before {
    content: '';
    position: absolute;
    left: 0; right: 0; top: -10px;
    height: 16px;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(var(--mega-cols, 4), minmax(0, 1fr));
    gap: var(--s-4);
  }
  .mega__group + .mega__group { margin-top: var(--s-4); }
  .mega__heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin: 0 0 var(--s-2);
    padding-left: 0.6rem;
  }
  .mega ul { list-style: none; margin: 0; padding: 0; }
  .mega__item {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--r-input);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition: background var(--t-fast), border-color var(--t-fast);
  }
  .mega__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--c-navy);
    transition: color var(--t-fast);
  }
  .mega__desc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--c-text-muted);
  }
  .mega__arrow { flex-shrink: 0; color: var(--c-text-muted); transition: transform var(--t-fast), color var(--t-fast); }
  .mega__item:hover,
  .mega__item:focus-visible,
  .mega__item[aria-current="page"] {
    background: var(--c-cream);
    border-left-color: var(--c-gold);
  }
  .mega__item:hover .mega__label,
  .mega__item:focus-visible .mega__label { color: var(--c-gold-text); }
  .mega__item:hover .mega__arrow,
  .mega__item:focus-visible .mega__arrow { color: var(--c-gold-text); transform: translateX(2px); }
  .mega__item:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 1px; }

  .mega__strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-4);
    padding: var(--s-3) 0.6rem var(--s-4);
    border-top: 1px solid var(--c-border);
  }
  .mega__migrate {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--c-navy);
    text-decoration: none;
  }
  .mega__migrate:hover { color: var(--c-gold-text); }
  .mega__btns { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .mega__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--c-navy);
    border: 1.5px solid var(--c-border);
    border-radius: var(--r-btn);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--t-fast), color var(--t-fast), background var(--t-fast);
  }
  .mega__btn:hover { border-color: var(--c-gold); color: var(--c-gold-text); background: var(--c-cream); }
  .mega__migrate:focus-visible,
  .mega__btn:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; border-radius: var(--r-input); }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 32px;
    padding: 4px;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--c-navy);
    border-radius: 2px;
    transition: transform var(--t-fast), opacity var(--t-fast);
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
    border-top: 1px solid var(--c-border);
    background: var(--c-white);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
  }
  .nav-mobile.is-open { display: flex; }

  /* ── Mega menu accordions (mobile) ──────────────────── */
  .macc__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    width: fit-content;
  }
  .macc__panel {
    margin-top: var(--s-2);
    padding: var(--s-2) 0 var(--s-2) var(--s-3);
    border-left: 2px solid var(--c-border-gold);
  }
  .macc__group + .macc__group { margin-top: var(--s-3); }
  .macc__group .mega__heading { padding-left: 0; }
  .macc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .macc a {
    color: var(--c-navy);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .macc a:hover,
  .macc a[aria-current="page"] { color: var(--c-gold-text); }
  .macc a:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; border-radius: 4px; }
  .macc__strip {
    display: grid;
    gap: 0.35rem;
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-border);
  }

  @media (max-width: 1180px) {
    .nav-desktop { gap: var(--s-3); }
    .nav-link { font-size: 0.95rem; }
    .status-cta__btn { padding: 0.45rem 0.8rem; }
  }
  @media (max-width: 1040px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: flex; }
    .status-cta { margin-left: auto; }
  }
  @media (max-width: 480px) {
    .site-header__inner { gap: var(--s-3); }
    .status-cta__btn { padding: 0.4rem 0.65rem; font-size: 0.85rem; }
    .status-cta__label { display: none; }
    .status-cta__label-short { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mega__panel, .mega__chev, .mega__arrow, .status-cta__btn { transition: none !important; }
    .status-cta__dot::after { animation: none !important; }
  }
</style>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
  });

  // Mobile mega menu accordions
  document.querySelectorAll<HTMLButtonElement>('[data-macc-trigger]').forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (panel) panel.hidden = !open;
    });
  });

  // Desktop mega menus: click toggles, hover opens with small delays; one open at a time.
  interface Mega { root: HTMLElement; trigger: HTMLButtonElement; isOpen: () => boolean; setOpen: (open: boolean) => void }
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const megas: Mega[] = [];
  document.querySelectorAll<HTMLElement>('[data-mega]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-mega-trigger]');
    if (!trigger) return;
    let openTimer: number | undefined;
    let closeTimer: number | undefined;
    const isOpen = () => root.classList.contains('is-open');
    const setOpen = (open: boolean) => {
      window.clearTimeout(openTimer);
      window.clearTimeout(closeTimer);
      if (open) megas.forEach((m) => m.root !== root && m.isOpen() && m.setOpen(false));
      root.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    trigger.addEventListener('click', () => setOpen(!isOpen()));

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !canHover.matches) return;
      window.clearTimeout(closeTimer);
      if (!isOpen()) openTimer = window.setTimeout(() => setOpen(true), 90);
    });
    root.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !canHover.matches) return;
      window.clearTimeout(openTimer);
      closeTimer = window.setTimeout(() => setOpen(false), 220);
    });
    root.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (isOpen() && next && !root.contains(next)) setOpen(false);
    });

    megas.push({ root, trigger, isOpen, setOpen });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = megas.find((m) => m.isOpen());
    if (open) {
      open.setOpen(false);
      open.trigger.focus();
    }
  });
  document.addEventListener('pointerdown', (e) => {
    megas.forEach((m) => {
      if (m.isOpen() && !m.root.contains(e.target as Node)) m.setOpen(false);
    });
  });

  // ── Live Claude status button ─────────────────────────────
  // One small request per page view at most (sessionStorage 60 s + HTTP max-age 60), then every
  // 60 s only while the tab is visible. The API serves a shared edge cache, never per-visitor upstream calls.
  (() => {
    const root = document.querySelector<HTMLElement>('[data-status-cta]');
    if (!root) return;
    const btn = root.querySelector<HTMLAnchorElement>('.status-cta__btn')!;
    const note = root.querySelector<HTMLElement>('.status-cta__note')!;
    const titleEl = root.querySelector<HTMLElement>('[data-status-title]')!;
    const textEl = root.querySelector<HTMLElement>('[data-status-text]')!;
    const API = '/api/claude-status?lite=1';
    const KEY = 'zmn-claude-status';
    const DISMISS_KEY = 'zmn-claude-status-dismissed';
    const TTL = 60_000;
    const onStatusPage = /^\/claude-(status|coktu-mu)\/?$/.test(location.pathname);
    type Lite = {
      ok: boolean; level: string; title: string;
      affected: { name: string; statusLabel: string; level: string }[];
      incidents: string[]; maintenances: string[]; stale: boolean; fetchedAt: string;
    };
    const store = {
      get(k: string) { try { return sessionStorage.getItem(k); } catch { return null; } },
      set(k: string, v: string) { try { sessionStorage.setItem(k, v); } catch { /* private mode */ } },
    };
    let signature = '';

    const render = (d: Lite | null) => {
      const level = d?.ok ? d.level : 'unknown';
      root.dataset.level = level;
      if (!d?.ok) {
        btn.title = 'Claude altyapı durumu: bilgi şu an alınamadı';
        note.hidden = true;
        return;
      }
      btn.title = `Claude altyapı durumu: ${d.title}`;
      const problem = level !== 'operational' && level !== 'unknown';
      if (!problem) { note.hidden = true; signature = ''; return; }

      const parts: string[] = [];
      const sentence = (t: string) => (/[.!?]$/.test(t) ? t : `${t}.`);
      if (d.incidents.length) parts.push(sentence(d.incidents.slice(0, 2).join(' · ')));
      if (d.affected.length) {
        const names = d.affected.slice(0, 4).map((a) => `${a.name} (${a.statusLabel.toLocaleLowerCase('tr')})`);
        parts.push(`Etkilenen: ${names.join(', ')}${d.affected.length > 4 ? ` ve ${d.affected.length - 4} hizmet daha` : ''}.`);
      } else if (d.maintenances.length) {
        parts.push(sentence(d.maintenances.slice(0, 2).join(' · ')));
      }
      titleEl.textContent = d.title;
      textEl.textContent = parts.join(' ');
      signature = `${level}|${d.incidents.join('|')}|${d.affected.map((a) => a.name + a.level).join('|')}`;
      note.hidden = onStatusPage || store.get(DISMISS_KEY) === signature;
    };

    const load = async (force = false) => {
      if (!force) {
        try {
          const c = JSON.parse(store.get(KEY) || 'null') as { t: number; d: Lite } | null;
          if (c && Date.now() - c.t < TTL) { render(c.d); return; }
        } catch { /* ignore */ }
      }
      try {
        const r = await fetch(API, { headers: { accept: 'application/json' } });
        const d = (await r.json()) as Lite;
        if (d?.ok) store.set(KEY, JSON.stringify({ t: Date.now(), d }));
        render(d);
      } catch {
        render(null);
      }
    };

    root.querySelector('[data-status-close]')?.addEventListener('click', () => {
      note.hidden = true;
      if (signature) store.set(DISMISS_KEY, signature);
    });

    let timer: number | undefined;
    const schedule = () => {
      window.clearInterval(timer);
      if (document.visibilityState === 'visible') timer = window.setInterval(() => load(), TTL);
    };
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') load();
      schedule();
    });
    load();
    schedule();
  })();
</script>
