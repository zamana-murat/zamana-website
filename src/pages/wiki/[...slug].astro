---
import { getCollection } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { wikiPublished } from '../../data/wiki-published';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry) => {
    // Map entry slug → URL slug:
    //   index               → ''        → /wiki/
    //   temeller/index      → temeller  → /wiki/temeller/
    //   temeller/foo        → temeller/foo → /wiki/temeller/foo/
    let urlSlug = entry.slug;
    if (urlSlug === 'index') urlSlug = '';
    else urlSlug = urlSlug.replace(/\/index$/, '');
    return {
      params: { slug: urlSlug || undefined },
      props: { entry, urlSlug },
    };
  });
}

const { entry, urlSlug } = Astro.props;
const { Content, headings } = await entry.render();
// First-publish date from repo history; new pages not in the map fall back to lastUpdated.
const firstAdded = wikiPublished[urlSlug];
const lastUpdated = entry.data.lastUpdated;
const publishDate = firstAdded && (!lastUpdated || firstAdded <= lastUpdated) ? firstAdded : lastUpdated;
---

<WikiLayout
  slug={urlSlug}
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  tags={entry.data.tags}
  headings={headings}
  publishDate={publishDate}
  modifiedDate={entry.data.lastUpdated}
>
  <Content />
</WikiLayout>
