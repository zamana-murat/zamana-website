---
import Layout from '../../layouts/Layout.astro';

const rows = [
  { label: 'Süre',                  ceo: '3 saat tek oturum',              bireysel: '3 hafta + 3 ay destek',     kurumsal: 'Minimum 3 ay, sonra aylık uzar' },
  { label: 'Katılımcı sayısı',       ceo: '1 kişi (yönetici)',               bireysel: '1 kişi',                    kurumsal: '6 çalışan' },
  { label: 'Kişi başı eğitim saati', ceo: '3 saat',                          bireysel: '6 saat (3×2)',              kurumsal: '6 saat (2×3)' },
  { label: 'Toplam eğitim saati',    ceo: '3 saat',                          bireysel: '6 saat',                    kurumsal: '36 saat (6 × 6)' },
  { label: 'Telefon desteği',        ceo: 'Standart müşteri iletişimi',     bireysel: '3 ay sınırsız',             kurumsal: 'Sınırsız (tüm ekip, eğitim süresince)' },
  { label: 'Format (İstanbul içi)',   ceo: 'Yerinde yüz yüze',                bireysel: 'Yerinde yüz yüze',          kurumsal: 'Yerinde yüz yüze' },
  { label: 'Format (İstanbul dışı)',  ceo: 'Yerinde ya da online (kişi tercihi, yerinde seçilirse seyahat masrafı kişiye ait)', bireysel: 'Zoom/Google Meet',          kurumsal: 'Yerinde ya da online (firma tercihi, yerinde seçilirse seyahat masrafı firmaya ait)' },
  { label: 'Zaman',                  ceo: 'Hafta sonu (Cumartesi/Pazar)',   bireysel: 'Hafta içi veya hafta sonu', kurumsal: 'Hafta içi mesai saatinde' },
  { label: 'Fiyat',                  ceo: '15.000 TL + KDV (tek seferlik)',  bireysel: '40.000 TL + KDV (tek seferlik)', kurumsal: '100.000 TL + KDV / ay (min. 3 ay, ödeme aylık)' },
  { label: 'Kişi başı maliyet',      ceo: '15.000 TL',                       bireysel: '40.000 TL',                 kurumsal: '50.000 TL (3 ay için)' },
  { label: 'Claude aboneliği',       ceo: 'Zorunlu değil (tavsiye)',         bireysel: 'İlk ay Max önerilir (Pro ile de başlanabilir)', kurumsal: 'İlk ay Max önerilir; Team planı önerilir, zorunlu değil' },
  { label: 'Ek ders',                ceo: 'Yok',                             bireysel: 'Gerek görülürse ücretsiz',  kurumsal: 'Gerek görülürse ücretsiz' },
  { label: 'Hedef alıcı',            ceo: 'Yöneticiler',                    bireysel: 'Bireysel profesyonel (B2C)', kurumsal: 'Şirket (B2B)' },
  { label: 'Müfredat odağı',         ceo: 'Anlama ve karar',                bireysel: 'Kişisel iş akışı',          kurumsal: 'Departman bazlı + ekip dinamiği' },
  { label: 'Çıktı',                   ceo: 'Yol haritası, karar',            bireysel: 'Çalışan kurulum + otomasyon', kurumsal: '6 Claude şampiyonu, ekip dönüşümü' },
  { label: 'Şirket içi yayılım',     ceo: "Yok (yöneticiye özel)",              bireysel: 'Yok (kişisel)',             kurumsal: '6 çalışan = kritik kütle' },
  { label: 'KVKK / politika',        ceo: 'Genel çerçeve, anonim vaka',     bireysel: 'Genel rehberlik',           kurumsal: 'Şirket politika dokümanı' },
  { label: 'İlerleme raporu',        ceo: 'Yok',                             bireysel: 'Yok',                       kurumsal: '1. ve 2. ay sunumu' },
];

const recRows: { situation: string; rec: string; href?: string }[] = [
  { situation: 'Yöneticisiniz, AI hakkında karar vermeniz gerek',          rec: 'Yönetici AI Hazırlık' },
  { situation: 'Şirkete yatırım yapmadan önce konuyu anlamak istiyorsunuz', rec: 'Yönetici AI Hazırlık' },
  { situation: 'Yöneticisiniz, şirkete getirmeden önce kendinize alacaksınız', rec: 'Önce Yönetici AI Hazırlık, sonra Bireysel veya Kurumsal' },
  { situation: 'Tek başınıza öğrenmek istiyorsunuz',                 rec: 'Bireysel' },
  { situation: 'Şirketiniz kurumsal program almıyor, kendiniz ödüyorsunuz', rec: 'Bireysel' },
  { situation: 'Freelance / bağımsız profesyonel',                   rec: 'Bireysel' },
  { situation: '6+ çalışanı olan şirket, AI dönüşümü istiyor',       rec: 'Kurumsal' },
  { situation: 'Küçük işletme (1-3 kişi)',                            rec: 'Her kilit kişi için Bireysel' },
  { situation: 'Büyük kurumsal şirket (50+ çalışan)',                rec: 'Genişletilmiş Kurumsal (12, 18 ya da 24 çalışan)' },
  { situation: '"Pazar sabahı evde öğrenmek isterim"',                 rec: 'Bireysel' },
  { situation: "Claude'u kurum içinde başkalarına siz öğreteceksiniz",  rec: 'AI Şampiyonu (şampiyon yolu)', href: '/programlar/ai-sampiyonu/' },
  { situation: 'Eğitmensiniz, kendi eğitimlerinizi Claude ile tasarlayacaksınız', rec: 'AI Şampiyonu (eğitmen yolu)', href: '/programlar/ai-sampiyonu/' },
  { situation: 'İhracat ya da dış ticaret ekibindesiniz',            rec: 'İhracatçılar için Claude', href: '/programlar/ihracatcilar/' },
  { situation: 'Avukatsınız ya da hukuk bürosusunuz',                rec: 'Hukuk Büroları için Claude', href: '/programlar/hukuk-burolari/' },
  { situation: 'Kamu kurumu ya da belediyesiniz',                     rec: 'Kamu Kurumları için Güvenli Kullanım', href: '/programlar/kamu-kurumlari/' },
  { situation: 'Akademisyen, araştırmacı ya da doktora öğrencisisiniz', rec: 'Akademisyenler için Araştırma ve Yazım', href: '/programlar/akademisyenler/' },
  { situation: 'Yeni mezun ya da son sınıf öğrencisisiniz',           rec: 'Yeni Mezun ve Kariyer Programı', href: '/programlar/yeni-mezun/' },
];
---

<Layout
  title="Yapay Zeka Eğitimi Fiyatları ve Nasıl Seçilir | Zamana"
  description="Kurumsal yapay zeka eğitimi ne kadar tutar? Fiyatı neyin belirlediği, tek günlük kurs ile 3 aylık program farkı ve eğitim seçerken sorulacak 7 soru."
  ogImage="/og/programlar-karsilastirma.png"
>

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Fiyat ve Seçim Rehberi</span>
      <h1>Yapay zeka eğitimi ne kadar tutar, nasıl seçilir?</h1>
      <p class="lead">
        Kurumsal yapay zeka eğitimi fiyatları süreye, kişi sayısına ve eğitimin ne kadar sizin işinize göre kurulduğuna göre değişir.
        Aşağıda Zamana fiyatları, fiyatı neyin belirlediği ve herhangi bir sağlayıcıya sorabileceğiniz 7 soru var. Sonra üç ana programı yan yana görebilirsiniz.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <h2 class="section-title">Zamana fiyatları</h2>
      <p class="text-muted">Tüm fiyatlar TL, KDV hariçtir.</p>
      <table class="rec-table">
        <thead>
          <tr><th>Program</th><th>Fiyat (+ KDV)</th></tr>
        </thead>
        <tbody>
          <tr><td><a href="/programlar/ceo-brifing/">Yönetici AI Hazırlık</a>, 3 saatlik tek oturum</td><td><strong>15.000 TL</strong></td></tr>
          <tr><td><a href="/programlar/bireysel/">Bireysel Program</a>, 3 hafta, 1 kişi, 3 ay destek dahil</td><td><strong>40.000 TL</strong>, tek seferlik. Sonrası aylık devam desteği 8.000 TL</td></tr>
          <tr><td><a href="/programlar/kurumsal/">Kurumsal Program</a>, 6 çalışan, minimum 3 ay</td><td><strong>100.000 TL / ay</strong> (3 ay için 300.000 TL)</td></tr>
          <tr><td>Kurumsal Program, 12 / 18 / 24 çalışan</td><td><strong>185.000 / 265.000 / 350.000 TL / ay</strong></td></tr>
          <tr><td><a href="/programlar/ai-sampiyonu/">AI Şampiyonu</a> (Şampiyon yolu / Eğitmen yolu)</td><td><strong>80.000 TL</strong> (Kurumsal müşteriye 65.000 TL) / <strong>45.000 TL</strong></td></tr>
          <tr><td><a href="/programlar/ihracatcilar/">İhracatçılar</a> ve <a href="/programlar/hukuk-burolari/">Hukuk Büroları</a></td><td><strong>45.000 TL</strong> tek kişi, ek kişi + 20.000 TL (2-4 kişi)</td></tr>
          <tr><td><a href="/programlar/kamu-kurumlari/">Kamu Kurumları</a> semineri / atölye</td><td><strong>45.000 TL</strong> (aynı kurumda ikinci seminer 35.000 TL) / <strong>30.000 TL</strong></td></tr>
          <tr><td><a href="/programlar/akademisyenler/">Akademisyenler</a></td><td><strong>30.000 TL</strong>, grup (3-6 kişi) 75.000 TL</td></tr>
          <tr><td><a href="/programlar/yeni-mezun/">Yeni Mezun</a> kohortu</td><td><strong>7.500 TL</strong> kişi başı</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container-narrow">
      <h2 class="section-title">Eğitim fiyatını ne belirler?</h2>
      <ul class="guide-list">
        <li><strong>Süre ve destek.</strong> Üç saatlik tek oturum ile 3 ay boyunca telefondan ulaşılabilen bir program aynı iş değildir. Fiyat farkının büyük kısmı burada.</li>
        <li><strong>Kaç kişi, hangi roller.</strong> Altı kişilik bir çekirdek grup ile tek kişilik birebir çalışma farklı emek ister. Rol bazlı müfredat (satış, finans, hukuk) hazırlık gerektirir.</li>
        <li><strong>Sizin işinize göre kurulması.</strong> Hazır slayt anlatmak ucuzdur. Sizin dosyalarınız, teklifleriniz ve süreçleriniz üzerinden çalışmak her ekip için ayrı hazırlık demek.</li>
        <li><strong>Yer.</strong> İstanbul içi yerinde oturumda ek ücret yok. İstanbul dışında yerinde oturum seçilirse yol ve konaklama için tipik ek 7.000-13.000 TL, online seçenekte bu ek yok.</li>
        <li><strong>Eğitim dışı kalemler.</strong> Claude aboneliği eğitim ücretine dahil değildir ve doğrudan Anthropic'ten alınır, Zamana abonelik satmaz. Yeni katılımcıya ilk ay Max planını öneririz, zorunlu değil. Sağlayıcınızın bu tür kalemleri baştan yazıp yazmadığına bakın.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <h2 class="section-title">Tek günlük kurs mu, 3 aylık program mı?</h2>
      <p class="text-muted">
        İkisi de yanlış bir seçim değil, farklı işler görüyor.
      </p>
      <ul class="guide-list">
        <li><strong>Tek günlük kurs</strong> aracı tanımak, kavramları öğrenmek ve karar verecek kişiyi bilgilendirmek için yeterli olabilir. Maliyeti düşüktür. Eksik kalan: öğrenilen şeyi ertesi gün kendi işine taşımak ve takılınca soracak biri.</li>
        <li><strong>3 aylık program</strong> alışkanlık kurmak içindir. Öğrenme oturumda değil, oturumlar arasındaki gerçek işte yaşanır; bu yüzden süre ve destek bilinçli tasarımdır. Maliyeti yüksektir ve ekibin gerçekten zaman ayırmasını gerektirir.</li>
        <li>Emin değilseniz küçük başlayın: 3 saatlik <a href="/programlar/ceo-brifing/">Yönetici AI Hazırlık</a>, 30 gün içinde Bireysel ya da Kurumsal Program'a geçerseniz ücret düşülür.</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container-narrow">
      <h2 class="section-title">Eğitim alırken sorulacak 7 soru</h2>
      <p class="text-muted">Bu sorular Zamana için de geçerli; hangi sağlayıcıyla konuşursanız konuşun sorun.</p>
      <ul class="guide-list">
        <li><strong>1. Kendi işimiz üzerinden mi çalışılıyor?</strong> Gerçek dosyalarınız ve süreçleriniz kullanılmıyorsa örnekler jenerik kalır.</li>
        <li><strong>2. Eğitim bittikten sonra destek var mı, ne kadar?</strong> İlk engelde vazgeçilmesini destek önler. Süreyi ve yanıt süresini yazılı isteyin.</li>
        <li><strong>3. Rol bazlı mı?</strong> Satış, finans ve hukuk ekiplerinin ihtiyacı farklıdır; tek müfredat hepsine oturmaz.</li>
        <li><strong>4. Veri güvenliği ve KVKK ele alınıyor mu?</strong> Hangi verinin yapay zekaya girmeyeceği şirkete özel bir karardır. Eğitimin sonunda yazılı bir kullanım politikası çıkmalı.</li>
        <li><strong>5. Türkçe mi, Türkiye'deki iş süreçlerine göre mi?</strong> Çevrilmiş içerik ile Türk iş kültürüne göre kurulmuş içerik farklı sonuç verir.</li>
        <li><strong>6. Toplam maliyet ne?</strong> Eğitim ücreti dışında araç aboneliği, seyahat, ek oturum gibi kalemleri baştan sorun.</li>
        <li><strong>7. Ne ölçülecek?</strong> "Eğitim verildi" ile "ekip artık kendi başına yeni akış kurabiliyor" arasında fark var. Hedefi baştan konuşun.</li>
      </ul>
      <p class="text-muted" style="margin-top: var(--s-3);">
        Daha geniş bir çerçeve için <a href="/yapay-zeka-egitimi/">kurumsal yapay zeka eğitimi rehberine</a> bakabilirsiniz.
      </p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <span class="eyebrow">Ana Programlar</span>
      <h2 class="section-title">Üç ana program yan yana</h2>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cmp-table-wrap">
        <table class="cmp-table">
          <thead>
            <tr>
              <th></th>
              <th>
                <div class="th-card">
                  <span class="th-tag">Bireysel</span>
                  <span class="th-price">40.000 TL <em>+ KDV</em></span>
                  <a href="/programlar/bireysel/" class="th-link">Detaylar →</a>
                </div>
              </th>
              <th>
                <div class="th-card th-card--gold">
                  <span class="th-tag">Kurumsal</span>
                  <span class="th-price">100.000 TL <em>+ KDV / ay</em></span>
                  <a href="/programlar/kurumsal/" class="th-link">Detaylar →</a>
                </div>
              </th>
              <th>
                <div class="th-card">
                  <span class="th-tag">Yönetici AI Hazırlık</span>
                  <span class="th-price">15.000 TL <em>+ KDV</em></span>
                  <a href="/programlar/ceo-brifing/" class="th-link">Detaylar →</a>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map(r => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.bireysel}</td>
                <td>{r.kurumsal}</td>
                <td>{r.ceo}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container-narrow">
      <span class="eyebrow">Hangisi Bana Uygun?</span>
      <h2 class="section-title">Durumunuza Göre Öneri</h2>

      <table class="rec-table">
        <thead>
          <tr>
            <th>Durumunuz</th>
            <th>Önerilen</th>
          </tr>
        </thead>
        <tbody>
          {recRows.map(r => (
            <tr>
              <td>{r.situation}</td>
              <td><strong>{r.href ? <a href={r.href}>{r.rec}</a> : r.rec}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container text-center">
      <h2>Hâlâ emin değil misiniz?</h2>
      <p class="lead center">
        15 dakikalık keşif görüşmesinde durumunuzu dinleyip size dürüst öneri veriyoruz,
        bazen "şu an hiçbiri uygun değil" deriz.
      </p>
      <div style="display: inline-flex; gap: var(--s-3); flex-wrap: wrap; justify-content: center; margin-top: var(--s-3);">
        <a href="/iletisim/" class="btn btn--primary btn--lg">Görüşme Talep Et</a>
        <a href="/sss/" class="btn btn--secondary btn--lg">Sık Sorulan Sorulara Bak</a>
      </div>
      <p class="text-muted" style="margin-top: var(--s-3); font-size: 0.95rem;">
        Ekibiniz hazır mı? <a href="/hazirlik-degerlendirmesi/">3 dakikalık Hazırlık Değerlendirmesi</a>
      </p>
    </div>
  </section>

</Layout>

<style>
  .cmp-table-wrap {
    overflow-x: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--c-border);
  }
  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--c-white);
    min-width: 880px;
  }
  .cmp-table th, .cmp-table td {
    padding: var(--s-3) var(--s-4);
    text-align: left;
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }
  .cmp-table thead th { padding: var(--s-3); border-bottom: 2px solid var(--c-border); }
  .cmp-table tbody th {
    width: 30%;
    color: var(--c-navy);
    font-weight: 600;
    background: var(--c-bg-subtle);
  }
  .cmp-table tbody tr:last-child th,
  .cmp-table tbody tr:last-child td { border-bottom: none; }

  .th-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-start;
    padding: var(--s-2);
  }
  .th-card--gold {
    background: var(--c-bg-subtle);
    border-radius: var(--r-card);
    border: 1px solid var(--c-border-gold);
  }
  .th-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-gold-text);
  }
  .th-price {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--c-navy);
  }
  .th-price em {
    font-size: 0.78rem;
    font-weight: 600;
    font-style: normal;
    color: var(--c-gold-text);
    margin-left: 0.25rem;
    letter-spacing: 0.04em;
  }
  .th-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--c-gold-text);
  }

  .rec-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-top: var(--s-4);
  }
  .rec-table th, .rec-table td {
    padding: var(--s-3) var(--s-4);
    text-align: left;
    border-bottom: 1px solid var(--c-border);
  }
  .rec-table thead th {
    background: var(--c-bg-subtle);
    color: var(--c-navy);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .rec-table tbody tr:last-child td { border-bottom: none; }
  .rec-table strong { color: var(--c-gold-text); }

  .final-cta {
    background: var(--c-bg-subtle);
    border-top: 1px solid var(--c-border);
  }
  .guide-list { display: grid; gap: var(--s-3); margin-top: var(--s-3); padding: 0; list-style: none; }
  .guide-list li {
    padding: var(--s-3) var(--s-4);
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-left: 3px solid var(--c-gold);
    border-radius: var(--r-card);
    line-height: 1.7;
  }
  .guide-list strong { color: var(--c-navy); }
  .guide-list a { color: var(--c-gold-text); text-decoration: underline; }
  .rec-table a { color: inherit; text-decoration: underline; }
</style>
